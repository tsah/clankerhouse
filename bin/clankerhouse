#!/bin/sh
# Clankerhouse interactive workshop and clanker navigator.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
[ "${CLANKERHOUSE_MULTIPLEXER:-}" != hc ] || exec "$script_dir/clankerhouse-hc" "$@"
[ "${CLANKERHOUSE_MULTIPLEXER:-}" != rex ] || exec "$script_dir/clankerhouse-rex" "$@"
exec "$script_dir/clankerhouse-herdr" "$@"
