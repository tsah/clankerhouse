#!/bin/bash

set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/../libexec/clankerhouse-env"
clankerhouse_require_tmux clankerhouse-delete || exit $?

pane=${1:-}
session=${2:-}
client=${3:-}
[[ "$pane" =~ ^%[0-9]+$ ]] || exit 2
[[ "$session" =~ ^\$[0-9]+$ ]] || exit 2

if tui_pid=$("$script_dir/clankerhouse-tui-active" "$pane" "$client" --pid); then
    # A tmux popup has no pane target, so send-keys would write behind it.
    # Both picker implementations translate SIGUSR1 into their normal Alt-D
    # confirmation path without bypassing typed daemon mutations.
    if [[ "$tui_pid" =~ ^[0-9]+$ ]] && kill -USR1 "$tui_pid" 2>/dev/null; then
        exit 0
    fi
fi

name=$(tmux display-message -p -t "$session" '#{session_name}')
tagged_path=$(tmux display-message -p -t "$session" '#{@dotfiles_worktree_path}')
session_path=$(tmux display-message -p -t "$session" '#{session_path}')
candidate_path=${tagged_path:-$session_path}
delete_kind=session
delete_path=
if [[ -n "$candidate_path" && -d "$candidate_path" ]]; then
    identity=$(git -C "$candidate_path" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null || true)
    git_dir=${identity%%$'\n'*}
    common_dir=${identity#*$'\n'}
    if [[ -n "$git_dir" && -n "$common_dir" && "$git_dir" != "$common_dir" ]]; then
        delete_kind=worktree
        delete_path=$candidate_path
    fi
fi

exec tmux display-popup -E -t "$pane" -w 64 -h 16 \
    -e "CLANKERHOUSE_TARGET=$session" \
    -e "CLANKERHOUSE_TARGET_NAME=$name" \
    -e "CLANKERHOUSE_DELETE_KIND=$delete_kind" \
    -e "CLANKERHOUSE_DELETE_PATH=$delete_path" \
    "$script_dir/clankerhouse-stop-popup"
