#!/bin/bash

set -uo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$SCRIPT_DIR/../libexec/clankerhouse-env"

failures=0
warnings=0
ok() { printf 'ok      %s\n' "$1"; }
fail() { printf 'broken  %s\n' "$1"; failures=$((failures + 1)); }
warn() { printf 'optional %s\n' "$1"; warnings=$((warnings + 1)); }
required() { command -v "$1" >/dev/null 2>&1 && ok "$1: $(command -v "$1")" || fail "$1 is not installed"; }
optional() { command -v "$1" >/dev/null 2>&1 && ok "$1: $(command -v "$1")" || warn "$1 is not installed"; }

printf 'Clankerhouse home: %s\n' "$CLANKERHOUSE_HOME"
[[ -f "$CLANKERHOUSE_HOME/src/daemon.ts" ]] && ok 'Bun daemon source' || fail 'Bun daemon source missing'
[[ -x "$CLANKERHOUSE_HOME/native-client/target/release/clankerhouse-native" ]] && ok 'Rust native renderer' || fail 'Rust native renderer missing'
[[ -x "$CLANKERHOUSE_BIN_DIR/clankers" ]] && ok 'clankers command' || fail 'clankers command missing'
[[ -x "$CLANKERHOUSE_LIBEXEC/worktree-delete" ]] && ok 'worktree helper' || fail 'worktree helper missing'
required bun
if [[ "${CLANKERHOUSE_MULTIPLEXER:-tmux}" == herdr ]]; then
    required herdr
else
    required tmux
fi
required git
required python3
required flock
optional wt
optional jq
optional zoxide
optional pi
optional claude
optional opencode2
optional codex

if rg -n --glob '!clankerhouse-doctor' '(\$HOME|%h)/dotfiles|~/dotfiles' "$CLANKERHOUSE_HOME/bin" "$CLANKERHOUSE_HOME/src" "$CLANKERHOUSE_HOME/share" >/dev/null 2>&1; then
    fail 'standalone runtime still contains a dotfiles path dependency'
else
    ok 'no dotfiles path dependencies in standalone runtime'
fi

if [[ "${CLANKERHOUSE_MULTIPLEXER:-tmux}" == tmux && -n "${TMUX:-}" ]]; then
    root=$(tmux show-option -gqv @clankerhouse-root 2>/dev/null || true)
    [[ -n "$root" ]] && ok "tmux plugin loaded: $root" || warn 'tmux plugin is not loaded'
fi

if command -v systemctl >/dev/null 2>&1; then
    for unit in clankerhouse-recovery.service clankerhouse-resource-guard.service clankerhouse-spot-watch.service; do
        state=$(systemctl --user is-enabled "$unit" 2>/dev/null || true)
        [[ "$state" == enabled ]] && ok "$unit enabled" || warn "$unit not enabled"
    done
fi
printf '\n%d broken, %d optional gaps\n' "$failures" "$warnings"
((failures == 0))
