#!/bin/bash

set -uo pipefail
libexec_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../libexec" && pwd)
# shellcheck source=/dev/null
. "$libexec_dir/clankerhouse-env"
# shellcheck source=/dev/null
. "$libexec_dir/clankerhouse-mux"

if [[ "${1:-}" != "--" || $# -lt 2 ]]; then
    echo "Usage: clankerhouse-harness-lifecycle -- COMMAND [ARG ...]" >&2
    exit 2
fi
shift

# The harness remains the foreground command in the pane's process group, so
# terminal signals reach it directly exactly once. These traps keep the wrapper
# alive to mark the exit; they must not forward a duplicate signal.
trap ':' INT HUP TERM

# A pane can outlive its harness, held open by a leftover child. Marking the harness exited
# lets discovery drop the clanker instead of reporting its last state forever. A relaunch in
# the same pane clears the mark.
exit_mark=""
pane=$(ch_mux_pane)
if [[ -n "$pane" && -n "${CLANKER_ID:-}" ]]; then
    exit_mark="$(ch_runtime_dir)/clanker-state/${pane//[^A-Za-z0-9_.%-]/_}.exited"
    rm -f "$exit_mark"
fi

status=0
"$@" || status=$?

if [[ -n "$exit_mark" ]]; then
    { mkdir -p -m 700 "${exit_mark%/*}" && printf '%s\n' "$CLANKER_ID" >"$exit_mark"; } 2>/dev/null || true
fi

exit "$status"
