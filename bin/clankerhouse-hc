#!/bin/bash
# Clankerhouse on the hc lane (CLANKERHOUSE_MULTIPLEXER=hc). hc draws nothing and binds no keys, so this launcher is the
# operator's way in: it starts the core and daemon, runs the picker, and attaches to what the picker opens. Ctrl+\ detaches
# back to the picker.
#
#   clankerhouse-hc [picker args]   run the picker
#   clankerhouse-hc --repo          open at repository selection (Herdr's Alt-B)
#   clankerhouse-hc --delete        delete the current session (Herdr's Alt-D)
#   clankerhouse-hc --scratch       pick a repository for a scratch Workshop (Herdr's Alt-N)
#   clankerhouse-hc --needs-me      open the list in its needs-me view (Herdr's Alt-I); inside, Alt-I/E/F switch views
#   clankerhouse-hc --needs-me --json [--eldest|--flat]  print that list instead, no terminal needed (clankers needs-me)
#   clankerhouse-hc --popup [--focus T] [--repo|--delete|--scratch|--needs-me]  the picker in a Herdr app popup over terminal T: exits on a choice, leaving it for the mod
#   clankerhouse-hc --report-focus T  record the terminal the Herdr app has focused
#   clankerhouse-hc --session-row DIR  print the picker's row (title, project, branch, labels) for the session holding DIR,
#                                      with the counts for "N need you · M open" (needsMe, open)
#   clankerhouse-hc --ensure-server start the core and daemon, then exit
#   clankerhouse-hc --stop-server   stop the daemon; the core and its terminals keep running
#   clankerhouse-hc --health        print core and daemon health; exit 1 when either is down
#   clankerhouse-hc --help          print this
#
# The daemon runs as a systemd user service, not in an hc terminal: the exit sweep kills anything a terminal started, and
# a daemon inside hc would die with the holder it needs to report on. Where no user manager is reachable it runs in its
# own session with a scrubbed environment, which the sweep also leaves alone.
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$SCRIPT_DIR/../libexec/clankerhouse-env"

export CLANKERHOUSE_MULTIPLEXER=hc
export CLANKERHOUSE_INSTANCE=${CLANKERHOUSE_INSTANCE:-hc}
export HC_SESSION=${HC_SESSION:-clankerhouse}
# shellcheck source=/dev/null
. "$CLANKERHOUSE_LIBEXEC/clankerhouse-mux"

# Nothing here draws or starts anything: no terminal is needed, and a down daemon stays down.
case "${1:-}" in
    -h|--help) sed -n '2,/^set -euo pipefail$/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0 ;;
    --needs-me)
        for argument in "${@:2}"; do
            [[ $argument == --json ]] && exec "$CLANKERHOUSE_BIN_DIR/clankers" needs-me "${@:2}"
        done
        [[ -t 1 ]] || { echo "The needs-me view needs a terminal; without one use: clankerhouse-hc --needs-me --json (or clankers needs-me)" >&2; exit 2; }
        ;;
esac

command -v bun >/dev/null 2>&1 || { echo "Clankerhouse requires bun" >&2; exit 1; }
command -v "${HC_BIN:-hc}" >/dev/null 2>&1 || { echo "Clankerhouse's hc lane requires hc (herdr-core)" >&2; exit 1; }

cd "$CLANKERHOUSE_HOME" || exit 1

STATE_DIR="$(ch_runtime_dir)"
LOG_FILE="$STATE_DIR/server.log"
DAEMON_SOCKET="$STATE_DIR/daemon.sock"
LOCK_FILE="$STATE_DIR/server.lock"
ATTACH_FILE="$STATE_DIR/hc-attach"
NATIVE_BINARY="$CLANKERHOUSE_HOME/native-client/target/release/clankerhouse-native"
CLANKERS="$CLANKERHOUSE_BIN_DIR/clankers"
UNIT="clankerhouse-daemon-${CLANKERHOUSE_INSTANCE//[^A-Za-z0-9_-]/-}.service"
export CLANKERHOUSE_RUNTIME_DIR="$STATE_DIR"

[[ -x "$NATIVE_BINARY" ]] || { echo "Native client is not built: $NATIVE_BINARY" >&2; exit 1; }

user_manager() {
    [[ -z "${CLANKERHOUSE_HC_NO_SYSTEMD:-}" && "${XDG_RUNTIME_DIR:-}" == "/run/user/$(id -u)" && -S "$XDG_RUNTIME_DIR/systemd/private" ]]
}

server_running() {
    [[ -S "$DAEMON_SOCKET" ]] || return 1
    "$NATIVE_BINARY" --server-health "$OWNER" >/dev/null 2>&1
}

stop_daemon() {
    if user_manager; then
        systemctl --user stop "$UNIT" 2>/dev/null || true
        systemctl --user reset-failed "$UNIT" 2>/dev/null || true
    fi
    local pid=
    [[ -r "$STATE_DIR/server.pid" ]] && pid=$(<"$STATE_DIR/server.pid")
    if [[ "$pid" =~ ^[0-9]+$ ]] && tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'src/daemon.ts --server'; then
        kill "$pid" 2>/dev/null || true
        for _ in {1..100}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
    fi
    rm -f "$DAEMON_SOCKET"
}

# One explicit environment for both paths, so nothing of the invoking clanker reaches the daemon.
daemon_env() {
    "$CLANKERS" mux hc-env
    printf '%s\n' "CLANKERHOUSE_HOME=$CLANKERHOUSE_HOME" "CLANKERHOUSE_BIN_DIR=$CLANKERHOUSE_BIN_DIR" "CLANKERHOUSE_LIBEXEC=$CLANKERHOUSE_LIBEXEC" "CLANKERHOUSE_RUNTIME_DIR=$STATE_DIR"
    [[ -z "${HC_BIN:-}" ]] || printf 'HC_BIN=%s\n' "$HC_BIN"
    [[ -z "${CLANKERHOUSE_NOTIFY_COMMAND:-}" ]] || printf 'CLANKERHOUSE_NOTIFY_COMMAND=%s\n' "$CLANKERHOUSE_NOTIFY_COMMAND"
}

start_daemon() {
    local bun_path line
    local -a environment=()
    bun_path=$(command -v bun)
    while IFS= read -r line; do environment+=("$line"); done < <(daemon_env)
    if user_manager; then
        local -a setenv=()
        for line in "${environment[@]}"; do setenv+=("--setenv=$line"); done
        systemctl --user reset-failed "$UNIT" 2>/dev/null || true
        systemd-run --user --quiet --unit="$UNIT" --collect "--working-directory=$CLANKERHOUSE_HOME" \
            --property=Restart=on-failure --property=RestartSec=2 --property=KillMode=mixed --property=TimeoutStopSec=10s \
            "--property=StandardOutput=append:$LOG_FILE" "--property=StandardError=append:$LOG_FILE" \
            "${setenv[@]}" -- "$bun_path" src/daemon.ts --server
    else
        env -i "${environment[@]}" setsid nohup "$bun_path" src/daemon.ts --server >>"$LOG_FILE" 2>&1 </dev/null 9>&- &
        disown
    fi
}

report_focus() {
    [[ $2 =~ ^t[0-9a-z]+$ ]] || { echo "$1 takes a terminal address on this machine" >&2; exit 2; }
    mkdir -p -m 700 "$STATE_DIR"
    printf '%s\n' "$2" >"$STATE_DIR/hc-focus.tmp"
    mv "$STATE_DIR/hc-focus.tmp" "$STATE_DIR/hc-focus"
}

case "${1:-}" in
    --report-focus)
        [[ ${2:-} =~ ^t[0-9a-z]+$ ]] || { echo "--report-focus takes a terminal address on this machine" >&2; exit 2; }
        # A popup stands over the session it opened from. Older mods report it once its overlay takes focus, which
        # would overwrite that session before the picker reads it. Ask a running core only; never start one here.
        if [[ -S ${HC_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/herdr-core/$HC_SESSION.sock} ]] \
            && "${HC_BIN:-hc}" get --json "$2" 2>/dev/null | grep -q '"ch_popup":'; then
            exit 0
        fi
        report_focus --report-focus "$2"
        exit 0
        ;;
    --session-row)
        [[ -n ${2:-} ]] || { echo "--session-row takes a folder" >&2; exit 2; }
        # The daemon's snapshot is what the picker draws; the row whose folder holds DIR, deepest first.
        exec bun -e 'const [state, folder] = process.argv.slice(1)
let sessions = []
try { sessions = JSON.parse(await Bun.file(state).text()).sessions ?? [] } catch {}
const holds = (path) => path && (folder === path || folder.startsWith(path.endsWith("/") ? path : `${path}/`))
const row = sessions.filter((session) => holds(session.path)).sort((a, b) => b.path.length - a.path.length)[0]
// The daemon decided which rows need the operator (src/needs-me.ts); this only counts, as needsMeCounts does.
const open = new Set(), needing = new Set()
for (const session of sessions) {
  if (session.target?.type !== "session") continue
  const key = session.workshopId ?? session.path
  open.add(key)
  if (session.needsMe && !session.needsMe.snoozedUntil && !session.needsMe.waitingOn) needing.add(key)
}
const counts = { needsMe: needing.size, open: open.size }
console.log(JSON.stringify(row ? { name: row.name, title: row.title ?? null, project: row.project ?? null, branch: row.branch ?? null, labels: row.labels ?? [], ...counts } : counts))' "$STATE_DIR/state.json" "$2"
        ;;
    --stop-server) stop_daemon; exit 0 ;;
    --health)
        status=0
        "$CLANKERS" mux hc-health || status=1
        OWNER=$("$CLANKERS" mux instance-id 2>/dev/null || true)
        if [[ -n "$OWNER" ]] && server_running; then echo '{"daemon":"healthy"}'; else echo '{"daemon":"down"}'; status=1; fi
        exit "$status"
        ;;
esac

# Inside an hc terminal, HC_TERMINAL_SOCKET names that terminal's core and beats HC_SESSION (hcSocketPath). From another
# session's terminal, such as a Herdr app machine added without --session, the lane would see a foreign core, fail the
# daemon's owner check, and replace the healthy daemon.
lane_socket=${HC_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/herdr-core/$HC_SESSION.sock}
if [[ -z "${HC_SOCKET:-}" && -n "${HC_TERMINAL_SOCKET:-}" && "$HC_TERMINAL_SOCKET" != "$lane_socket" ]]; then
    printf 'This terminal belongs to the hc session at %s, not %s.\n' "$HC_TERMINAL_SOCKET" "$lane_socket" >&2
    printf 'On the Herdr app, add the machine with: hc machine add <target> --name <name> --session %s\n' "$HC_SESSION" >&2
    exit 1
fi

mkdir -p -m 700 "$STATE_DIR"
if [[ -L "$STATE_DIR" || ! -d "$STATE_DIR" || ! -O "$STATE_DIR" ]]; then
    echo "Refusing unsafe Clankerhouse runtime directory: $STATE_DIR" >&2; exit 1
fi
chmod 700 "$STATE_DIR"
"$CLANKERS" mux hc-ensure >/dev/null
OWNER=$("$CLANKERS" mux instance-id)
exec 9>"$LOCK_FILE"
flock 9
ready=false
if server_running; then
    ready=true
else
    stop_daemon
    rm -f "$STATE_DIR/server.pid" "$STATE_DIR/state.json"
    start_daemon
    for _ in {1..1200}; do
        if server_running; then ready=true; break; fi
        sleep 0.05
    done
fi
[[ "$ready" == true ]] || { printf 'Clankerhouse hc daemon did not become healthy; see %s\n' "$LOG_FILE" >&2; exit 1; }
flock -u 9
exec 9>&-

[[ ${1:-} == "--ensure-server" ]] && exit 0
popup=false
if [[ ${1:-} == "--popup" ]]; then
    popup=true
    shift
    # The terminal the app had focused when the key was pressed; a focus report can lag a switch by seconds.
    popup_focus=none
    if [[ ${1:-} == "--focus" ]]; then
        report_focus --focus "${2:-}"
        popup_focus=$2
        shift 2
    fi
    # `hc run` copies the caller's TERM, here whatever the Herdr app was started with.
    export TERM=xterm-256color COLORTERM=truecolor
    # The popup's own terminal is no session: the picker's current one is what it opened over.
    CLANKERHOUSE_CURRENT_SESSION=$("$CLANKERS" mux current-location | sed -n 's/.*"nativeSessionId":"\([^"]*\)".*/\1/p')
    export CLANKERHOUSE_CURRENT_SESSION
    # What each popup was handed, for when it opens on the wrong row; the last 200 popups.
    popup_log() {
        printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$STATE_DIR/popup.log"
        tail -n 200 "$STATE_DIR/popup.log" >"$STATE_DIR/popup.log.tmp" && mv "$STATE_DIR/popup.log.tmp" "$STATE_DIR/popup.log"
    }
    popup_log "open terminal=${HC_TERMINAL_ID:-} focus=$popup_focus reported=$(cat "$STATE_DIR/hc-focus" 2>/dev/null) current=${CLANKERHOUSE_CURRENT_SESSION:-none} args=$*"
fi
if [[ ${1:-} == "--repo" ]]; then
    export CLANKERHOUSE_MODE=spawn
    shift
fi
if [[ ${1:-} == "--scratch" ]]; then
    export CLANKERHOUSE_MODE=scratch
    shift
fi
if [[ ${1:-} == "--needs-me" ]]; then
    export CLANKERHOUSE_MODE=needs-me
    shift
fi
if [[ ${1:-} == "--delete" ]]; then
    current=$("$CLANKERS" mux current-location | sed -n 's/.*"nativeSessionId":"\([^"]*\)".*/\1/p')
    [[ -n "$current" ]] || { echo "Refusing delete: no current session." >&2; exit 1; }
    export CLANKERHOUSE_CURRENT_SESSION="$current"
    shift
    set -- --delete-current "$@"
fi

if [[ "$popup" == true ]]; then
    rm -f "$ATTACH_FILE"
    status=0
    "$NATIVE_BINARY" "$@" || status=$?
    popup_log "close terminal=${HC_TERMINAL_ID:-} status=$status target=$(cat "$ATTACH_FILE" 2>/dev/null)"
    if [[ -s "$ATTACH_FILE" ]]; then
        "${HC_BIN:-hc}" label "$HC_TERMINAL_ID" "ch_popup_target=$(<"$ATTACH_FILE")" >/dev/null
        rm -f "$ATTACH_FILE"
    fi
    exit "$status"
fi

while :; do
    rm -f "$ATTACH_FILE"
    status=0
    "$NATIVE_BINARY" "$@" || status=$?
    [[ -s "$ATTACH_FILE" ]] || exit "$status"
    target=$(<"$ATTACH_FILE")
    rm -f "$ATTACH_FILE"
    "$CLANKERS" mux attach --pane "$target" || sleep 2
done
