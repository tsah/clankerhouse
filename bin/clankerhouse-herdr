#!/bin/bash
# Herdr native client. Invoked from a herdr `[[keys.command]]` popup. It pins the
# workspace that was active when the popup opened, ensures the Clankerhouse daemon for
# this herdr server is running, and launches the picker. The popup closes when this
# process exits.
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$SCRIPT_DIR/../libexec/clankerhouse-env"
# shellcheck source=/dev/null
. "$CLANKERHOUSE_LIBEXEC/clankerhouse-mux"

if ! command -v bun >/dev/null 2>&1; then echo "Clankerhouse requires bun" >&2; exit 1; fi
if [[ -z "${HERDR_SOCKET_PATH:-}" ]]; then
    HERDR_SOCKET_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
    [[ -n "${HERDR_SESSION:-}" ]] && HERDR_SOCKET_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sessions/$HERDR_SESSION/herdr.sock"
fi
export HERDR_SOCKET_PATH
# Delete always targets the invoking popup's workspace, never inherited picker context.
if [[ ${1:-} == "--delete" ]]; then
    if [[ -z "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]]; then
        echo "Refusing delete without HERDR_ACTIVE_WORKSPACE_ID from the invoking herdr popup." >&2
        exit 1
    fi
    export CLANKERHOUSE_CURRENT_SESSION="$HERDR_ACTIVE_WORKSPACE_ID"
    shift
    set -- --delete-current "$@"
else
    # Herdr popups export this workspace id, not HERDR_PANE_ID.
    export CLANKERHOUSE_CURRENT_SESSION="${CLANKERHOUSE_CURRENT_SESSION:-${HERDR_ACTIVE_WORKSPACE_ID:-}}"
fi

[[ -S "$HERDR_SOCKET_PATH" ]] || { echo "No herdr server at $HERDR_SOCKET_PATH — start one with 'herdr'." >&2; exit 1; }

cd "$CLANKERHOUSE_HOME" || exit 1

STATE_DIR="$(ch_runtime_dir)"
LOG_FILE="$STATE_DIR/server.log"
PID_FILE="$STATE_DIR/server.pid"
DAEMON_SOCKET="$STATE_DIR/daemon.sock"
LOCK_FILE="$STATE_DIR/server.lock"
EXPECTED_OWNER="herdr:$HERDR_SOCKET_PATH"
NATIVE_BINARY="$CLANKERHOUSE_HOME/native-client/target/release/clankerhouse-native"
export CLANKERHOUSE_RUNTIME_DIR="$STATE_DIR"

[[ -x "$NATIVE_BINARY" ]] || { echo "Native client is not built: $NATIVE_BINARY" >&2; exit 1; }

server_running() {
    [[ -S "$DAEMON_SOCKET" ]] || return 1
    "$NATIVE_BINARY" --server-health "$EXPECTED_OWNER" >/dev/null 2>&1
}

retire_stale_server() {
    [[ -r "$PID_FILE" ]] || return 0
    local old_pid old_cwd old_cmdline
    old_pid=$(<"$PID_FILE")
    [[ "$old_pid" =~ ^[0-9]+$ && -r "/proc/$old_pid/environ" ]] || return 0
    old_cwd=$(readlink -f "/proc/$old_pid/cwd" 2>/dev/null || true)
    old_cmdline=$(tr '\0' ' ' <"/proc/$old_pid/cmdline")
    [[ "$old_cwd" == "$PWD" && "$old_cmdline" == *"bun src/daemon.ts --server"* ]] || return 0
    tr '\0' '\n' <"/proc/$old_pid/environ" | grep -Fqx "HERDR_SOCKET_PATH=$HERDR_SOCKET_PATH" || return 0
    kill "$old_pid" 2>/dev/null || return 0
    for _ in {1..100}; do
        kill -0 "$old_pid" 2>/dev/null || return 0
        sleep 0.05
    done
    kill -KILL "$old_pid" 2>/dev/null || true
}

mkdir -p -m 700 "$STATE_DIR"
if [[ -L "$STATE_DIR" || ! -d "$STATE_DIR" || ! -O "$STATE_DIR" ]]; then
    echo "Refusing unsafe Clankerhouse runtime directory: $STATE_DIR" >&2; exit 1
fi
chmod 700 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9
ready=false
if server_running; then
    ready=true
else
    retire_stale_server
    rm -f "$DAEMON_SOCKET" "$PID_FILE" "$STATE_DIR/state.json"
    nohup bun src/daemon.ts --server >>"$LOG_FILE" 2>&1 9>&- &
    launched_pid=$!
    for _ in {1..1200}; do
        if server_running; then ready=true; break; fi
        if ! kill -0 "$launched_pid" 2>/dev/null; then
            printf 'Clankerhouse herdr daemon exited during startup; see %s\n' "$LOG_FILE" >&2; exit 1
        fi
        sleep 0.05
    done
fi
[[ "$ready" == true ]] || { printf 'Clankerhouse herdr daemon did not become healthy; see %s\n' "$LOG_FILE" >&2; exit 1; }

flock -u 9
exec 9>&-

[[ ${1:-} == "--ensure-server" ]] && exit 0
# Alt-B opens directly at repository/branch selection.
if [[ ${1:-} == "--repo" ]]; then
    export CLANKERHOUSE_MODE=spawn
    shift
fi

exec "$NATIVE_BINARY" "$@"
