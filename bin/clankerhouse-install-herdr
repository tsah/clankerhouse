#!/usr/bin/env python3
"""Install or refresh Clankerhouse herdr integration: Alt-K/Alt-B/Alt-D popup keybindings and
Herdr agent restore turned off (resume_agents_on_restore = false) in herdr's config.toml, so
a restart leaves interrupted clankers for `clankers resume` rather than relaunching them.

Idempotent: the keybindings live inside a managed marker block that is replaced on reruns;
the session setting is updated in place. Pass --uninstall to remove the managed block.

Each key is chosen by CLANKERHOUSE_HERDR_KEY, CLANKERHOUSE_HERDR_SPAWN_KEY, or
CLANKERHOUSE_HERDR_DELETE_KEY when set, otherwise the key already in the managed block,
otherwise the default. A key edited in the block therefore survives reruns and upgrades.
"""
import os
import sys
from pathlib import Path

BEGIN = "# >>> clankerhouse herdr keybindings (managed) >>>"
END = "# <<< clankerhouse herdr keybindings (managed) <<<"


# (command suffix, environment override, default key, description), in block order.
BINDINGS = [
    ("", "CLANKERHOUSE_HERDR_KEY", "alt+k", "Clankerhouse jump"),
    (" --repo", "CLANKERHOUSE_HERDR_SPAWN_KEY", "alt+b", "Clankerhouse open/create branch"),
    (" --delete", "CLANKERHOUSE_HERDR_DELETE_KEY", "alt+d", "Clankerhouse delete current session"),
]


def toml_string(line: str) -> str:
    return line.split("=", 1)[1].strip().strip('"')


def installed_keys(text: str) -> dict:
    """Keys currently in the managed block, by command suffix."""
    if BEGIN not in text:
        return {}
    block = text.partition(BEGIN)[2].partition(END)[0]
    keys = {}
    for entry in block.split("[[keys.command]]")[1:]:
        fields = {}
        for line in entry.split("\n"):
            name = line.split("=", 1)[0].strip()
            if "=" in line and name in ("key", "command"):
                fields[name] = toml_string(line)
        if "key" not in fields or "command" not in fields:
            continue
        # Longest suffix first: the bare launcher's empty suffix matches every command.
        for suffix, *_ in sorted(BINDINGS, key=lambda binding: -len(binding[0])):
            if fields["command"].endswith(suffix):
                keys[suffix] = fields["key"]
                break
    return keys


def managed_block(launcher: str, installed: dict) -> str:
    lines = [
        BEGIN,
        "# Regenerated by clankerhouse-install-herdr. Edited keys are kept; other edits are overwritten.",
    ]
    for index, (suffix, variable, default, description) in enumerate(BINDINGS):
        key = os.environ.get(variable) or installed.get(suffix) or default
        if index:
            lines.append("")
        lines += [
            "[[keys.command]]",
            f'key = "{key}"',
            'type = "popup"',
            f'command = "{launcher}{suffix}"',
            f'description = "{description}"',
            'width = "90%"',
            'height = "80%"',
        ]
    lines.append(END)
    return "\n".join(lines)


def strip_block(text: str) -> str:
    if BEGIN not in text:
        return text
    head, _, rest = text.partition(BEGIN)
    _, _, tail = rest.partition(END)
    out = head.rstrip("\n") + "\n" + tail.lstrip("\n")
    return out.strip("\n") + "\n" if out.strip() else ""


def set_session_flag(text: str) -> str:
    """Ensure [session] resume_agents_on_restore = false, preserving the rest."""
    lines = text.split("\n")
    in_session = False
    seen = False
    session_at = None
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if in_session and not seen:
                lines.insert(session_at + 1, "resume_agents_on_restore = false")
                seen = True
            in_session = stripped == "[session]"
            if in_session:
                session_at = i
            continue
        if in_session and stripped.split("=")[0].strip() == "resume_agents_on_restore":
            indent = line[: len(line) - len(line.lstrip())]
            lines[i] = f"{indent}resume_agents_on_restore = false"
            seen = True
    if in_session and not seen:
        lines.append("resume_agents_on_restore = false")
        seen = True
    text = "\n".join(lines)
    if not seen:
        text = (text.rstrip("\n") + "\n\n" if text.strip() else "") + "[session]\nresume_agents_on_restore = false\n"
    return text


def main() -> int:
    uninstall = "--uninstall" in sys.argv
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    config = Path(args[0]) if args else Path(
        os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
    ) / "herdr" / "config.toml"
    launcher = os.environ.get("CLANKERHOUSE_HERDR_LAUNCHER") or str(
        Path(__file__).resolve().parent / "clankerhouse-herdr"
    )

    # Dotfile managers symlink config.toml into a repository. Write through the link
    # (an atomic replace of the link itself would silently detach it) and leave an
    # already-current file untouched so that repository stays clean.
    config = config.resolve()
    config.parent.mkdir(parents=True, exist_ok=True)
    original = config.read_text(encoding="utf-8") if config.exists() else ""

    text = strip_block(original)
    if not uninstall:
        text = set_session_flag(text)
        text = (text.rstrip("\n") + "\n\n" if text.strip() else "") + managed_block(launcher, installed_keys(original)) + "\n"

    if text == original:
        print(f"Clankerhouse herdr keybindings already current in {config}")
        return 0

    tmp = config.with_suffix(config.suffix + ".clankerhouse-tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(config)
    action = "removed from" if uninstall else "installed into"
    print(f"Clankerhouse herdr keybindings {action} {config}")
    if not uninstall:
        print("Reload herdr config with: herdr server reload-config  (or restart herdr)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
