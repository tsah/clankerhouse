#!/bin/bash
set -euo pipefail

progress() {
    [[ "${CLANKERHOUSE_PROGRESS:-0}" == 1 ]] || return 0
    printf 'CLANKERHOUSE_PROGRESS\t%s\n' "$1" >&2
}

kind="${1:-}"
target="${2:-}"
[[ "$kind" == pane || "$kind" == session || "$kind" == mark-session ]] && [[ -n "$target" ]] || {
    echo "Usage: clankerhouse-mux-stop pane|session|mark-session TARGET" >&2
    exit 2
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
clankers_cli=${CLANKERHOUSE_CLANKERS:-"$script_dir/clankers"}
CLANKERHOUSE_CLANKERS=$clankers_cli
# shellcheck source=/dev/null
. "$script_dir/../libexec/clankerhouse-env"
# shellcheck source=/dev/null
. "$script_dir/../libexec/clankerhouse-mux"
progress "Finding tracked clankers"
if [[ "$kind" == pane ]]; then
    ids=$(ch_mux_pane_clanker_id "$target")
else
    ids=$(ch_mux_session_clanker_ids "$target")
fi
while IFS= read -r clanker_id; do
    [[ -n "$clanker_id" ]] || continue
    progress "Closing $clanker_id in the clanker ledger"
    if ! stop_output=$("$clankers_cli" ledger close "$clanker_id" --reason intentional-multiplexer-stop --if-present 2>&1); then
        printf 'Unable to close %s in the clanker ledger: %s\n' "$clanker_id" "$stop_output" >&2
        exit 1
    fi
done <<<"$ids"
progress "Clankers closed"

if [[ "$kind" == "mark-session" ]]; then
    exit 0
fi
if [[ "$kind" == pane ]]; then
    progress "Closing pane"
    ch_mux_kill pane "$target"
    exit
fi
progress "Closing session"
ch_mux_kill session "$target"
