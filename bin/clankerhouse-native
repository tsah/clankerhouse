#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$SCRIPT_DIR/../libexec/clankerhouse-env"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/../libexec/clankerhouse-mux"

if [[ "${CLANKERHOUSE_MULTIPLEXER:-tmux}" == herdr ]]; then
    exec "$SCRIPT_DIR/clankerhouse-herdr" "$@"
fi

binary="$CLANKERHOUSE_HOME/native-client/target/release/clankerhouse-native"
if [[ ! -x "$binary" ]]; then
    echo "Native client is not built. Run: $CLANKERHOUSE_HOME/scripts/build-native" >&2
    exit 1
fi

STATE_DIR="$(ch_runtime_dir)"
CURRENT_TMUX_SOCKET=${TMUX:-}
CURRENT_TMUX_SOCKET=${CURRENT_TMUX_SOCKET%%,*}
if [[ ! -s "$STATE_DIR/state.json" || ! -r "$STATE_DIR/server.version" || "$(<"$STATE_DIR/server.version")" != 10 || ! -r "$STATE_DIR/server.tmux-socket" || "$(<"$STATE_DIR/server.tmux-socket")" != "$CURRENT_TMUX_SOCKET" ]]; then
    "$SCRIPT_DIR/clankerhouse-picker" --ensure-server
else
    # Keep a hot snapshot on the launch path and validate/restart its producer
    # out of band so opening the jump client never waits on collection.
    "$SCRIPT_DIR/clankerhouse-picker" --ensure-server >/dev/null 2>&1 &
fi

if [[ ! -s "$STATE_DIR/state.json" ]]; then
    echo "Clankerhouse could not initialize its snapshot." >&2
    exit 1
fi

exec "$binary" "$@"
