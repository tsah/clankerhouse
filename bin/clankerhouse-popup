#!/bin/bash

set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/../libexec/clankerhouse-env"
clankerhouse_require_tmux clankerhouse-popup || exit $?

restore_delete_binding() {
    local delete_key=$1
    tmux bind-key -n "$delete_key" run-shell \
        "'$script_dir/clankerhouse-delete' '#{pane_id}' '#{session_id}' #{q:client_name}" 2>/dev/null || true
}

if [[ ${1:-} == "--run" ]]; then
    delete_key=${2:-}
    jump_command=${3:-}
    [[ -n "$delete_key" && "$jump_command" == /* && -x "$jump_command" ]] || exit 2
    trap 'restore_delete_binding "$delete_key"' EXIT INT TERM
    "$jump_command"
    exit
fi

client=${1:-}
current_session=${2:-}
jump_command=${3:-}
[[ -n "$client" && -n "$current_session" && "$jump_command" == /* && -x "$jump_command" ]] || {
    echo "Usage: clankerhouse-popup CLIENT CURRENT_SESSION ABSOLUTE_COMMAND" >&2
    exit 2
}

delete_key=$(tmux show-option -gqv @clankerhouse-delete-key)
delete_key=${delete_key:-M-d}

# A popup has no pane target, and tmux closes it before running a matching root
# binding. Let the popup receive Alt-D directly. The command running inside the
# popup restores standalone Delete when the popup exits.
tmux unbind-key -n "$delete_key" 2>/dev/null || true
if ! tmux display-popup -E -c "$client" -w 90% -h 80% \
    -e "CLANKERHOUSE_CURRENT_SESSION=$current_session" \
    -e "CLANKERHOUSE_TMUX_CLIENT=$client" \
    "$script_dir/clankerhouse-popup" --run "$delete_key" "$jump_command"
then
    restore_delete_binding "$delete_key"
    exit 1
fi
