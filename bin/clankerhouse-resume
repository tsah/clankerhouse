#!/bin/bash
# Recovery gate (ADR-0009). Herdr's native session restore types
#   clankerhouse-resume [--instance NAME] CLANKER_ID
# into a restored Clanker pane after a Herdr or host restart. The gate shows why it waits until
# Clankerhouse Recovery admits this Clanker into this pane, then execs the exact harness launch.
# It returns to the shell when the Clanker is stopped, deleted, or already running elsewhere.

set -uo pipefail
libexec_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../libexec" && pwd)

usage() { echo "Usage: clankerhouse-resume [--instance NAME] CLANKER_ID" >&2; exit 2; }
while (($#)); do
    case "$1" in
        --instance) [[ $# -ge 2 ]] || usage; export CLANKERHOUSE_INSTANCE=$2; shift 2 ;;
        -h|--help) usage ;;
        --) shift; break ;;
        -*) usage ;;
        *) break ;;
    esac
done
[[ $# -eq 1 && -n "$1" ]] || usage
clanker_id=$1

# shellcheck source=/dev/null
. "$libexec_dir/clankerhouse-mux"
pane=$(ch_mux_pane)
[[ -n "$pane" ]] || { echo "clankerhouse-resume runs inside a Herdr pane (HERDR_PANE_ID is not set)" >&2; exit 2; }
clankers=$(_ch_mux_clankers)

say() { printf '[clankerhouse-resume %s] %s\n' "$(date +%H:%M:%S)" "$*"; }

argv_file=$(mktemp "${TMPDIR:-/tmp}/clankerhouse-resume.XXXXXX") || exit 1
launched=false
cleanup() {
    rm -f -- "$argv_file"
    # A gate that leaves without launching must not keep advertising itself to Recovery.
    [[ "$launched" == true ]] || "$clankers" mux claim --pane "$pane" recoveryGate --unset >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

say "Restored pane for $clanker_id. Clankerhouse Recovery decides when it continues."
retry=5
hint_shown=false
while :; do
    if ! output=$("$clankers" recovery gate "$clanker_id" --pane "$pane" --argv-out "$argv_file" 2>&1); then
        say "Clankerhouse could not decide yet: ${output##*$'\n'}"
        say "Retrying in ${retry}s."
        sleep "$retry"
        retry=$((retry < 60 ? retry * 2 : 60))
        continue
    fi
    retry=5
    action=${output%%$'\n'*}
    rest=${output#*$'\n'}
    message=${rest%%$'\n'*}
    status=${rest#*$'\n'}
    case "$action" in
        launch)
            say "$message"
            mapfile -d '' -t argv <"$argv_file"
            ((${#argv[@]})) || { say "Recovery returned an empty launch; leaving the pane to the shell."; exit 1; }
            launched=true
            rm -f -- "$argv_file"
            trap - EXIT INT TERM HUP
            exec "${argv[@]}"
            ;;
        exit)
            say "$message"
            exit 0
            ;;
        wait)
            say "$message"
            if [[ "$hint_shown" == false ]]; then
                say "Ctrl-C returns to the shell. To keep $clanker_id down, run: clankers recovery stop $clanker_id"
                hint_shown=true
            fi
            shown=$message
            # Poll Recovery's status files, not the daemon; consult Clankerhouse again on
            # admission or once a minute.
            for _ in {1..60}; do
                [[ -e "$status.admitted" ]] && break
                if [[ -r "$status.reason" ]]; then
                    reason=$(<"$status.reason")
                    if [[ -n "$reason" && "$reason" != "$shown" ]]; then
                        say "$reason"
                        shown=$reason
                    fi
                fi
                sleep 1
            done
            ;;
        *)
            say "Unexpected answer from Clankerhouse: $output"
            sleep 5
            ;;
    esac
done
