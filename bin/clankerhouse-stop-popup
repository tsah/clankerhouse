#!/bin/bash

set -uo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/../libexec/clankerhouse-env"
clankerhouse_require_tmux clankerhouse-stop-popup || exit $?

progress_prefix=$'CLANKERHOUSE_PROGRESS\t'
target=${1:-${CLANKERHOUSE_TARGET:-}}
if [[ -z "$target" && -n "${TMUX_PANE:-}" ]]; then
    target=$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null || true)
fi
[[ "$target" =~ ^\$[0-9]+$ ]] || { printf 'Unable to resolve tmux session: %q\n' "$target" >&2; exit 2; }
name=${2:-${CLANKERHOUSE_TARGET_NAME:-$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null || printf session)}}
delete_kind=${CLANKERHOUSE_DELETE_KIND:-session}
delete_path=${CLANKERHOUSE_DELETE_PATH:-}
[[ "$delete_kind" == session || "$delete_kind" == worktree ]] || { printf 'Unsupported deletion scope: %s\n' "$delete_kind" >&2; exit 2; }
[[ "$delete_kind" != worktree || -n "$delete_path" ]] || { printf 'Worktree deletion requires an exact path\n' >&2; exit 2; }
scope_label="tmux session"
[[ "$delete_kind" == worktree ]] && scope_label="session and worktree"

steps=()
errors=()
frame=0
finished=0

repeat_glyph() {
    local count=$1 glyph=$2
    while ((count > 0)); do
        printf '%s' "$glyph"
        count=$((count - 1))
    done
}

append_error() {
    local line=$1 message detail
    if [[ "$line" == \{* ]] && message=$(jq -er '.error.message | select(type == "string" and length > 0)' <<<"$line" 2>/dev/null); then
        while IFS= read -r detail; do
            [[ -n "$detail" ]] && errors+=("$detail")
        done <<<"$message"
    else
        errors+=("$line")
    fi
}

render() {
    local width=18 segment=5 position line index
    position=$((frame % (width - segment + 1)))
    printf '\033[2J\033[H'
    printf '\033[1;33mDestroy %s %q?\033[0m\n\n' "$scope_label" "$name"
    if [[ ${#steps[@]} -eq 0 ]]; then
        printf 'Press \033[1my\033[0m to confirm or any other key to cancel.\n'
        return
    fi
    if ((finished)); then
        printf '\033[1;32mDestroyed %s.\033[0m\n\n' "$scope_label"
    else
        printf '\033[1;36mDestroying %s… [\033[33m' "$scope_label"
        repeat_glyph "$position" '·'
        repeat_glyph "$segment" '█'
        repeat_glyph "$((width - segment - position))" '·'
        printf '\033[36m]\033[0m\n\n'
    fi
    for ((index = 0; index < ${#steps[@]}; index++)); do
        line=${steps[$index]}
        if ((finished || index < ${#steps[@]} - 1)); then
            printf '\033[2m✓ %s\033[0m\n' "$line"
        else
            printf '\033[33m▶ %s\033[0m\n' "$line"
        fi
    done
    if [[ ${#errors[@]} -gt 0 ]]; then
        printf '\n'
        for line in "${errors[@]}"; do
            printf '\033[31m%s\033[0m\n' "$line"
        done
    fi
}

render
# Depending on terminal timing, tmux can deliver the Alt-D trigger's trailing
# Escape/d bytes to the newly opened popup. Ignore only those trigger bytes;
# wait for an explicit confirmation or cancellation key.
while true; do
    IFS= read -rsn1 answer || answer=""
    case "$answer" in
        y|Y) break ;;
        d|D|$'\e') continue ;;
        *) exit 0 ;;
    esac
done
steps+=("Preparing deletion")
render

coproc STOP_COMMAND {
    if [[ "$delete_kind" == worktree ]]; then
        CLANKERHOUSE_PROGRESS=1 "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/clankers" delete worktree --session "$target" --path "$delete_path" --yes 2>&1
    else
        CLANKERHOUSE_PROGRESS=1 "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/clankerhouse-tmux-stop" mark-session "$target" 2>&1
    fi
}
stop_pid=$STOP_COMMAND_PID
stop_fd=${STOP_COMMAND[0]}
exec {stop_read_fd}<&"$stop_fd"
while kill -0 "$stop_pid" 2>/dev/null; do
    if IFS= read -r -t 0.1 line <&"$stop_read_fd"; then
        if [[ "$line" == "$progress_prefix"* ]]; then
            step=${line#"$progress_prefix"}
            [[ "${steps[-1]}" == "$step" ]] || steps+=("$step")
        elif [[ -n "$line" ]]; then
            append_error "$line"
        fi
    fi
    frame=$((frame + 1))
    render
done
while IFS= read -r line <&"$stop_read_fd"; do
    if [[ "$line" == "$progress_prefix"* ]]; then
        step=${line#"$progress_prefix"}
        [[ "${steps[-1]}" == "$step" ]] || steps+=("$step")
    elif [[ -n "$line" ]]; then
        append_error "$line"
    fi
done
exec {stop_read_fd}<&-
wait "$stop_pid"
status=$?
if ((status != 0)); then
    if [[ ${#errors[@]} -eq 0 ]]; then
        if [[ "$delete_kind" == worktree ]]; then
            errors+=("Deletion failed (exit $status).")
        else
            errors+=("Unable to persist stop intent (exit $status).")
        fi
    fi
    render
    printf '\nPress any key to close.\n'
    IFS= read -rsn1 _ || true
    exit "$status"
fi

if [[ "$delete_kind" == worktree ]]; then
    finished=1
    render
    sleep 0.75
    exit 0
fi

steps+=("Closing tmux session")
frame=$((frame + 1))
render
sleep 0.2
tmux switch-client -n 2>/dev/null || true
exec tmux kill-session -t "$target"
