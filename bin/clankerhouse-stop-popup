#!/bin/bash

set -uo pipefail

progress_prefix=$'CLANKERHOUSE_PROGRESS\t'
target=${1:-${CLANKERHOUSE_TARGET:-}}
if [[ -z "$target" && -n "${TMUX_PANE:-}" ]]; then
    target=$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null || true)
fi
[[ "$target" =~ ^\$[0-9]+$ ]] || { printf 'Unable to resolve tmux session: %q\n' "$target" >&2; exit 2; }
name=${2:-$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null || printf session)}

steps=()
errors=()
frame=0

render() {
    local width=18 segment=5 position line index
    position=$((frame % (width - segment + 1)))
    printf '\033[2J\033[H'
    printf '\033[1;33mDestroy tmux session %q?\033[0m\n\n' "$name"
    if [[ ${#steps[@]} -eq 0 ]]; then
        printf 'Press \033[1my\033[0m to confirm or any other key to cancel.\n'
        return
    fi
    printf '\033[1;36mDestroying session… [\033[33m'
    printf '%*s' "$position" '' | tr ' ' '·'
    printf '%*s' "$segment" '' | tr ' ' '█'
    printf '%*s' "$((width - segment - position))" '' | tr ' ' '·'
    printf '\033[36m]\033[0m\n\n'
    for ((index = 0; index < ${#steps[@]}; index++)); do
        line=${steps[$index]}
        if ((index == ${#steps[@]} - 1)); then
            printf '\033[33m▶ %s\033[0m\n' "$line"
        else
            printf '\033[2m✓ %s\033[0m\n' "$line"
        fi
    done
    if [[ ${#errors[@]} -gt 0 ]]; then
        printf '\n\033[31m%s\033[0m\n' "${errors[-1]}"
    fi
}

render
# Depending on terminal timing, tmux can deliver the Alt-D trigger's trailing
# Escape/d bytes to the newly opened popup. Ignore only those trigger bytes;
# wait for an explicit confirmation or cancellation key.
while true; do
    IFS= read -rsn1 answer || answer=""
    case "$answer" in
        y|Y) break ;;
        d|D|$'\e') continue ;;
        *) exit 0 ;;
    esac
done
steps+=("Preparing deletion")
render

coproc STOP_COMMAND {
    CLANKERHOUSE_PROGRESS=1 "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/clankerhouse-tmux-stop" mark-session "$target" 2>&1
}
stop_pid=$STOP_COMMAND_PID
stop_fd=${STOP_COMMAND[0]}
exec {stop_read_fd}<&"$stop_fd"
while kill -0 "$stop_pid" 2>/dev/null; do
    if IFS= read -r -t 0.1 line <&"$stop_read_fd"; then
        if [[ "$line" == "$progress_prefix"* ]]; then
            step=${line#"$progress_prefix"}
            [[ "${steps[-1]}" == "$step" ]] || steps+=("$step")
        elif [[ -n "$line" ]]; then
            errors+=("$line")
        fi
    fi
    frame=$((frame + 1))
    render
done
while IFS= read -r line <&"$stop_read_fd"; do
    if [[ "$line" == "$progress_prefix"* ]]; then
        step=${line#"$progress_prefix"}
        [[ "${steps[-1]}" == "$step" ]] || steps+=("$step")
    elif [[ -n "$line" ]]; then
        errors+=("$line")
    fi
done
exec {stop_read_fd}<&-
wait "$stop_pid"
status=$?
if ((status != 0)); then
    errors+=("Unable to persist stop intent (exit $status).")
    render
    printf '\nPress any key to close.\n'
    IFS= read -rsn1 _ || true
    exit "$status"
fi

steps+=("Closing tmux session")
frame=$((frame + 1))
render
sleep 0.2
tmux switch-client -n 2>/dev/null || true
exec tmux kill-session -t "$target"
