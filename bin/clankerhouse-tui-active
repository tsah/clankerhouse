#!/bin/bash

set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/../libexec/clankerhouse-env"
clankerhouse_require_tmux clankerhouse-tui-active || exit $?

pane=${1:-}
client=${2:-}
mode=${3:-}
[[ "$pane" =~ ^%[0-9]+$ ]] || exit 1
[[ -z "$mode" || "$mode" == "--pid" ]] || exit 1

while IFS= read -r pid; do
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" && -r "/proc/$pid/environ" ]] || continue
    [[ "$(basename -- "$(readlink -f -- "/proc/$pid/exe")")" == "clankerhouse-native" ]] || continue
    process_identity=$(tr '\0' '\n' < "/proc/$pid/environ" | awk -F= '
        $1 == "TMUX_PANE" { pane = substr($0, index($0, "=") + 1) }
        $1 == "CLANKERHOUSE_TMUX_CLIENT" { client = substr($0, index($0, "=") + 1) }
        END { printf "%s\t%s", pane, client }
    ')
    process_pane=${process_identity%%$'\t'*}
    process_client=${process_identity#*$'\t'}
    if [[ "$process_pane" == "$pane" || ( -n "$client" && "$process_client" == "$client" ) ]]; then
        [[ "$mode" == "--pid" ]] && printf '%s\n' "$pid"
        exit 0
    fi
done < <(pgrep -u "$(id -u)" -f 'clankerhouse-native' 2>/dev/null || true)

exit 1
