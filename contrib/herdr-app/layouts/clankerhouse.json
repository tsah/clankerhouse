{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "movable": false,
  "theme": "graphite",
  "terminal_padding": [
    4,
    6
  ],
  "children": [
    {
      "id": "top",
      "type": "row",
      "size": {
        "px": 38
      },
      "window_drag": true,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "clankerhouse",
          "type": "block",
          "size": {
            "px": 640
          },
          "content": {
            "mod": "clankerhouse",
            "props": {
              "machine": "puffin",
              "launcher": "clankerhouse-hc"
            }
          }
        }
      ]
    },
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "gap": 1,
          "background": "background",
          "focus": {
            "width": 1,
            "color": "accent"
          }
        }
      }
    }
  ]
}
