#!/bin/sh

# Source this file from a Clankerhouse launcher. It resolves both source checkouts
# and prefix installs without assuming ~/dotfiles.
_clankerhouse_script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CLANKERHOUSE_HOME=${CLANKERHOUSE_HOME:-$(CDPATH= cd -- "$_clankerhouse_script_dir/.." && pwd)}
CLANKERHOUSE_BIN_DIR=${CLANKERHOUSE_BIN_DIR:-$CLANKERHOUSE_HOME/bin}
CLANKERHOUSE_LIBEXEC=${CLANKERHOUSE_LIBEXEC:-$CLANKERHOUSE_HOME/libexec}
export CLANKERHOUSE_HOME CLANKERHOUSE_BIN_DIR CLANKERHOUSE_LIBEXEC

for _clankerhouse_dir in "$HOME/.pi/agent/bin" "${BUN_INSTALL:-$HOME/.bun}/bin" "$HOME/.cargo/bin" "$HOME/.local/bin" "$HOME/.opencode/bin"; do
    case ":${PATH:-}:" in *":$_clankerhouse_dir:"*) ;; *) PATH="$_clankerhouse_dir:${PATH:-/usr/local/bin:/usr/bin:/bin}" ;; esac
done
export PATH
unset _clankerhouse_script_dir _clankerhouse_dir
