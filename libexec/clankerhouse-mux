#!/bin/bash
# Source this file from Clankerhouse shell scripts that must address their own pane or
# write identity claims. Every operation routes through `clankers mux`, so scripts never
# speak the Multiplexer's native protocol.
#
# Functions:
#   ch_mux_pane                 -> this process's pane address (HERDR_PANE_ID, or HC_TERMINAL_ID on the hc lane)
#   ch_mux_pane_read KEY        -> pane claim value
#   ch_mux_pane_claim KEY VALUE -> write pane claim
#   ch_mux_pane_unset KEY       -> clear pane claim
#   ch_mux_pane_path            -> pane current path
#   ch_mux_session_clanker_ids SESSION / ch_mux_pane_clanker_id PANE
#   ch_mux_kill pane|session TARGET

_ch_mux_clankers() {
    if [[ -n "${CLANKERHOUSE_CLANKERS:-}" ]]; then printf '%s\n' "$CLANKERHOUSE_CLANKERS"; return; fi
    if [[ -n "${CLANKERHOUSE_BIN_DIR:-}" && -x "$CLANKERHOUSE_BIN_DIR/clankers" ]]; then printf '%s\n' "$CLANKERHOUSE_BIN_DIR/clankers"; return; fi
    local here
    here=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
    printf '%s\n' "$here/bin/clankers"
}

_ch_mux_run_clankers() {
    "$(_ch_mux_clankers)" "$@"
}

ch_mux_pane() {
    if [[ "${CLANKERHOUSE_MULTIPLEXER:-}" == hc ]]; then printf '%s\n' "${HC_TERMINAL_ID:-}"; else printf '%s\n' "${HERDR_PANE_ID:-}"; fi
}

ch_mux_pane_read() {
    local pane key
    pane=$(ch_mux_pane); key=$1
    [[ -n "$pane" ]] || return 0
    _ch_mux_run_clankers mux read-claim --pane "$pane" "$key" 2>/dev/null || true
}

ch_mux_pane_claim() {
    local pane key value
    pane=$(ch_mux_pane); key=$1; value=$2
    [[ -n "$pane" ]] || return 0
    _ch_mux_run_clankers mux claim --pane "$pane" "$key" "$value" 2>/dev/null || true
}

ch_mux_pane_unset() {
    local pane key
    pane=$(ch_mux_pane); key=$1
    [[ -n "$pane" ]] || return 0
    _ch_mux_run_clankers mux claim --pane "$pane" "$key" --unset 2>/dev/null || true
}

ch_mux_pane_path() {
    local pane path
    pane=$(ch_mux_pane)
    if [[ -n "$pane" ]]; then
        path=$(_ch_mux_run_clankers mux pane-path --pane "$pane" 2>/dev/null || true)
        [[ -z "$path" ]] || { printf '%s\n' "$path"; return 0; }
    fi
    pwd -P
}

ch_mux_pane_clanker_id() {
    _ch_mux_run_clankers mux clanker-ids --pane "$1" 2>/dev/null || true
}

ch_mux_session_clanker_ids() {
    _ch_mux_run_clankers mux clanker-ids --session "$1" 2>/dev/null || true
}

ch_mux_kill() {
    if [[ "$1" == pane ]]; then _ch_mux_run_clankers mux kill --pane "$2"; else _ch_mux_run_clankers mux kill --session "$2"; fi
}

# Instance scoping: CLANKERHOUSE_INSTANCE names a separate instance with its own
# runtime and state directories; otherwise the Herdr instance paths are used.
ch_instance_slug() {
    if [[ -n "${CLANKERHOUSE_INSTANCE:-}" ]]; then
        local instance
        instance=$(printf '%s' "$CLANKERHOUSE_INSTANCE" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$instance" in
            default) printf '' ;;
            ""|.|..|*[!A-Za-z0-9._-]*) printf 'Invalid CLANKERHOUSE_INSTANCE: %s\n' "$instance" >&2; return 2 ;;
            *) printf -- '-%s' "$instance" ;;
        esac
        return
    fi
    printf -- '-herdr'
}

ch_runtime_dir() {
    printf '%s/clankerhouse-%s%s' "${XDG_RUNTIME_DIR:-/tmp}" "$(id -u)" "$(ch_instance_slug)"
}

ch_state_dir() {
    printf '%s/clankerhouse%s' "${XDG_STATE_HOME:-$HOME/.local/state}" "$(ch_instance_slug)"
}
