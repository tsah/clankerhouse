{
  "name": "clankerhouse",
  "version": "0.1.0",
  "description": "Herdr-native workshops, visible harness sessions, and durable recovery",
  "license": "MIT",
  "author": "Tsah Weiss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsah/clankerhouse.git"
  },
  "homepage": "https://github.com/tsah/clankerhouse#readme",
  "bugs": {
    "url": "https://github.com/tsah/clankerhouse/issues"
  },
  "type": "module",
  "keywords": [
    "herdr",
    "tui",
    "worktree",
    "developer-tools"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "clankerhouse": "bin/clankerhouse",
    "clankers": "bin/clankers",
    "clankerhouse-doctor": "bin/clankerhouse-doctor"
  },
  "scripts": {
    "start": "bin/clankerhouse",
    "server": "bun run src/daemon.ts --server",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:all": "./test",
    "test:unit": "./test --unit",
    "test:standalone": "./test --standalone",
    "test:native": "cargo test --manifest-path native-client/Cargo.toml",
    "qa:native-hot": "scripts/qa-native-hot",
    "test:nvim": "scripts/qa-nvim",
    "qa:api": "scripts/qa-clanker-api",
    "qa:daemon": "scripts/qa-daemon",
    "qa:recovery": "scripts/qa-recovery",
    "qa:process-owner": "scripts/qa-process-owner",
    "qa:herdr": "scripts/qa-herdr",
    "qa:install": "scripts/qa-install",
    "qa:tui": "scripts/qa",
    "qa": "./test",
    "doctor": "bin/clankerhouse-doctor"
  },
  "files": [
    "bin",
    "libexec",
    "src",
    "integrations",
    "lua",
    "plugin",
    "share",
    "docs",
    "scripts",
    "tests",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "dependencies": {
    "effect": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
