#!/bin/bash

set -euo pipefail

source_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
prefix=${CLANKERHOUSE_PREFIX:-${PREFIX:-$HOME/.local}}
with_systemd=false
with_integrations=false
with_herdr=false
enable_services=true
dry_run=false
force=false
no_daemon_handoff=false
runtime_dir=
tmux_socket=
preflight_hook=
activation_hook=

usage() {
    echo "Usage: scripts/install [--prefix PATH] [--systemd] [--integrations] [--herdr] [--no-enable] [--runtime-dir PATH --tmux-socket PATH | --no-daemon-handoff] [--preflight-hook PATH] [--activation-hook PATH] [--dry-run] [--force]"
}
while (($#)); do
    case "$1" in
        --prefix) prefix=${2:?}; shift 2 ;;
        --systemd) with_systemd=true; shift ;;
        --integrations) with_integrations=true; shift ;;
        --herdr) with_herdr=true; shift ;;
        --no-enable) enable_services=false; shift ;;
        --runtime-dir) runtime_dir=${2:?}; shift 2 ;;
        --tmux-socket) tmux_socket=${2:?}; shift 2 ;;
        --no-daemon-handoff) no_daemon_handoff=true; shift ;;
        --preflight-hook) preflight_hook=${2:?}; shift 2 ;;
        --activation-hook) activation_hook=${2:?}; shift 2 ;;
        --dry-run) dry_run=true; shift ;;
        --force) force=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done
[[ "$prefix" != *$'\n'* ]] || { echo "Install prefix may not contain a newline" >&2; exit 2; }
prefix=$(realpath -m -- "$prefix")
if [[ -n "$runtime_dir" || -n "$tmux_socket" ]]; then
    [[ -n "$runtime_dir" && -n "$tmux_socket" ]] || { echo "--runtime-dir and --tmux-socket must be supplied together" >&2; exit 2; }
    [[ "$no_daemon_handoff" == false ]] || { echo "Cannot combine an isolated daemon selection with --no-daemon-handoff" >&2; exit 2; }
    runtime_dir=$(realpath -m -- "$runtime_dir")
    tmux_socket=$(realpath -m -- "$tmux_socket")
fi
for hook in "$preflight_hook" "$activation_hook"; do
    [[ -z "$hook" || -x "$hook" ]] || { echo "Install fault hook is not executable: $hook" >&2; exit 2; }
done

lib_dir="$prefix/lib"
active="$lib_dir/clankerhouse"
versions="$lib_dir/clankerhouse-versions"
bin_dir="$prefix/bin"
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/clankerhouse/installations
manifest="$state_root/$(printf '%s' "$prefix" | sha256sum | cut -d' ' -f1).files"
daemon_hook="$source_root/scripts/install-daemon-hook"
stage=
active_tmp=
manifest_next="$manifest.next"
cleanup() {
    [[ -z "$active_tmp" ]] || rm -f -- "$active_tmp"
    [[ -z "$stage" ]] || rm -rf -- "$stage"
    rm -f -- "$manifest_next"
}
trap cleanup EXIT

managed_or_absent() {
    local path=$1
    [[ ! -e "$path" && ! -L "$path" ]] && return 0
    [[ -f "$manifest" ]] && grep -Fx -- "$path" "$manifest" >/dev/null && return 0
    [[ "$force" == true ]]
}
refuse_unmanaged() {
    local path=$1 description=$2
    managed_or_absent "$path" || { echo "Refusing unmanaged $description: $path" >&2; exit 1; }
}
record() { printf '%s\n' "$1" >> "$manifest_next"; }
install_symlink() {
    local source=$1 destination=$2 temporary
    if [[ -L "$destination" && "$(readlink -- "$destination")" == "$source" ]]; then
        return
    fi
    mkdir -p "$(dirname "$destination")"
    temporary="$(dirname "$destination")/.$(basename "$destination").next.$$"
    ln -s "$source" "$temporary"
    mv -Tf "$temporary" "$destination"
}

refuse_unmanaged "$active" "installation"
if [[ (-e "$active" || -L "$active") && -z "$runtime_dir" && "$no_daemon_handoff" == false && "$dry_run" == false ]]; then
    echo "Upgrades require --runtime-dir and --tmux-socket for isolated daemon handoff, or explicit --no-daemon-handoff after quiescing it yourself" >&2
    exit 2
fi
if [[ "$dry_run" == true ]]; then
    echo "Would stage, validate, and atomically activate Clankerhouse under $versions"
    exit 0
fi

mkdir -p "$lib_dir" "$bin_dir" "$state_root"
[[ -d "$lib_dir" && ! -L "$lib_dir" && -O "$lib_dir" ]] || { echo "Refusing unsafe application directory: $lib_dir" >&2; exit 1; }
if [[ -e "$versions" || -L "$versions" ]]; then
    [[ -d "$versions" && ! -L "$versions" && -O "$versions" ]] || { echo "Refusing unsafe versions directory: $versions" >&2; exit 1; }
else
    mkdir -m 755 "$versions"
fi
stage=$(mktemp -d "$versions/.stage-XXXXXX")
tar -C "$source_root" --exclude='./.git' --exclude='./node_modules' --exclude='./native-client/target' --exclude='./__pycache__' --exclude='*.pyc' -cf - . | tar -C "$stage" -xf -
if [[ -n "$preflight_hook" ]]; then "$preflight_hook" "$stage"; fi
(
    cd "$stage"
    bun install --frozen-lockfile
    scripts/build-native
    bun run check
    bun test
)

package_version=$(python3 - "$stage/package.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["version"])
PY
)
source_revision=$(git -C "$source_root" rev-parse --short=12 HEAD 2>/dev/null || printf 'archive')
version_id=$(printf '%s-%s-%s-%s' "$package_version" "$source_revision" "$(date -u +%Y%m%dT%H%M%SZ)" "$$" | tr -c 'A-Za-z0-9._-' '-')
final="$versions/$version_id"
[[ ! -e "$final" && ! -L "$final" ]] || { echo "Version target already exists: $final" >&2; exit 1; }
printf 'prefix=%s\nversion=%s\n' "$prefix" "$version_id" > "$stage/.clankerhouse-install"

# Refuse every optional or public destination before changing any of them.
for command in "$stage"/bin/*; do
    [[ -f "$command" && -x "$command" ]] || continue
    refuse_unmanaged "$bin_dir/$(basename "$command")" "command"
done
if [[ "$with_integrations" == true ]]; then
    declare -a integration_destinations=(
        "$HOME/.pi/agent/extensions/tmux-clanker-lifecycle.ts"
        "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins/clankerhouse-lifecycle.ts"
        "$HOME/.agents/skills/clanker-coordination"
        "$HOME/.claude/skills/clanker-coordination"
        "$HOME/.pi/agent/skills/clanker-coordination"
        "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills/clanker-coordination"
        "$HOME/.codex/skills/clanker-coordination"
    )
    for destination in "${integration_destinations[@]}"; do refuse_unmanaged "$destination" "integration"; done
fi
if [[ "$with_systemd" == true ]]; then
    unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
    for template in "$stage"/share/systemd/user/*.in; do
        refuse_unmanaged "$unit_dir/$(basename "${template%.in}")" "unit"
    done
fi

mv "$stage" "$final"
stage=

# Stable launchers resolve and validate exactly one active target per invocation.
for command in "$final"/bin/*; do
    [[ -f "$command" && -x "$command" ]] || continue
    name=$(basename "$command")
    destination="$bin_dir/$name"
    temporary="$bin_dir/.${name}.next.$$"
    python3 - "$temporary" "$active" "$versions" "$name" <<'PY'
from pathlib import Path
import shlex, sys
path, active, versions, name = sys.argv[1:]
text = f'''#!/bin/sh
set -eu
active={shlex.quote(active)}
versions={shlex.quote(versions)}
target=$(readlink -f -- "$active") || {{ echo "Clankerhouse has no valid active installation" >&2; exit 1; }}
case "$target/" in
  "$versions/"*) [ -f "$target/.clankerhouse-install" ] || {{ echo "Refusing unvalidated Clankerhouse target: $target" >&2; exit 1; }} ;;
  "$active/") [ -f "$target/src/daemon.ts" ] || [ -f "$target/src/main.tsx" ] || {{ echo "Refusing invalid legacy Clankerhouse target: $target" >&2; exit 1; }} ;;
  *) echo "Refusing unsafe Clankerhouse active target: $target" >&2; exit 1 ;;
esac
export CLANKERHOUSE_HOME="$target"
export CLANKERHOUSE_BIN_DIR="$target/bin"
export CLANKERHOUSE_LIBEXEC="$target/libexec"
exec "$target/bin/{name}" "$@"
'''
Path(path).write_text(text, encoding="utf-8")
PY
    chmod 755 "$temporary"
    mv -Tf "$temporary" "$destination"
done

if [[ "$with_integrations" == true ]]; then
    declare -a links=(
        "$active/integrations/pi/tmux-clanker-lifecycle.ts:$HOME/.pi/agent/extensions/tmux-clanker-lifecycle.ts"
        "$active/integrations/opencode/clankerhouse-lifecycle.ts:${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins/clankerhouse-lifecycle.ts"
    )
    for pair in "${links[@]}"; do
        source=${pair%%:*}; destination=${pair#*:}
        install_symlink "$source" "$destination"
    done
    for skill_root in "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.pi/agent/skills" "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills" "$HOME/.codex/skills"; do
        destination="$skill_root/clanker-coordination"
        install_symlink "$active/integrations/skills/clanker-coordination" "$destination"
    done
fi

if [[ "$with_herdr" == true ]]; then
    if command -v herdr >/dev/null 2>&1; then
        # Run the staged installer ($final); the launcher path is the stable bin wrapper.
        CLANKERHOUSE_HERDR_LAUNCHER="$bin_dir/clankerhouse-herdr" "$final/bin/clankerhouse-install-herdr" \
            || echo "Warning: herdr keybinding install failed; core install continues" >&2
    else
        echo "Skipping --herdr: herdr binary not found on PATH" >&2
    fi
fi

if [[ "$with_systemd" == true ]]; then
    mkdir -p "$unit_dir"
    for template in "$final"/share/systemd/user/*.in; do
        destination="$unit_dir/$(basename "${template%.in}")"
        temporary="$destination.next.$$"
        python3 - "$template" "$temporary" "$active" "$bin_dir" <<'PY'
from pathlib import Path
import sys
source, destination, active, bin_dir = sys.argv[1:]
text = Path(source).read_text().replace("@CLANKERHOUSE_HOME@", active).replace("@CLANKERHOUSE_BIN@", bin_dir)
Path(destination).write_text(text)
PY
        chmod 600 "$temporary"
        mv -Tf "$temporary" "$destination"
    done
fi

previous_target=
legacy_target=
if [[ -L "$active" ]]; then
    previous_target=$(realpath -e -- "$active")
    case "$previous_target/" in "$versions/"*) ;; *) echo "Refusing active target outside the managed versions directory: $previous_target" >&2; exit 1;; esac
    [[ -f "$previous_target/.clankerhouse-install" ]] || { echo "Refusing unvalidated active target: $previous_target" >&2; exit 1; }
elif [[ -d "$active" ]]; then
    legacy_target="$versions/legacy-$version_id"
    [[ ! -e "$legacy_target" ]] || { echo "Legacy compatibility target exists: $legacy_target" >&2; exit 1; }
elif [[ -e "$active" ]]; then
    echo "Refusing non-directory active installation: $active" >&2
    exit 1
fi

if [[ -n "$runtime_dir" && -n "$previous_target" ]]; then
    "$daemon_hook" quiesce --runtime-dir "$runtime_dir" --tmux-socket "$tmux_socket" --application "$previous_target"
elif [[ -n "$runtime_dir" && -n "$legacy_target" ]]; then
    "$daemon_hook" quiesce --runtime-dir "$runtime_dir" --tmux-socket "$tmux_socket" --application "$active"
fi

if [[ -n "$legacy_target" ]]; then
    mv "$active" "$legacy_target"
    printf 'prefix=%s\nversion=legacy-%s\n' "$prefix" "$version_id" > "$legacy_target/.clankerhouse-install"
    previous_target=$legacy_target
fi

switch_active() {
    local target=$1 relative
    relative=$(python3 - "$lib_dir" "$target" <<'PY'
import os, sys
print(os.path.relpath(sys.argv[2], sys.argv[1]))
PY
)
    active_tmp="$lib_dir/.clankerhouse-active.next.$$"
    rm -f -- "$active_tmp"
    ln -s "$relative" "$active_tmp"
    mv -Tf "$active_tmp" "$active"
    active_tmp=
}
switch_active "$final"

activation_ok=true
if [[ -n "$runtime_dir" ]]; then
    if ! "$daemon_hook" activate --runtime-dir "$runtime_dir" --tmux-socket "$tmux_socket" --application "$final"; then activation_ok=false; fi
fi
if [[ "$activation_ok" == true && -n "$activation_hook" ]] && ! "$activation_hook" "$final"; then activation_ok=false; fi
if [[ "$activation_ok" != true ]]; then
    echo "New version activation failed; restoring the previous target" >&2
    if [[ -n "$runtime_dir" ]]; then
        "$daemon_hook" quiesce --runtime-dir "$runtime_dir" --tmux-socket "$tmux_socket" --application "$final" || true
    fi
    if [[ -n "$previous_target" ]]; then
        switch_active "$previous_target"
        if [[ -n "$runtime_dir" ]]; then
            "$daemon_hook" restart --runtime-dir "$runtime_dir" --tmux-socket "$tmux_socket" --application "$previous_target" || {
                echo "Rollback restored $previous_target but its daemon health probe failed" >&2
                exit 1
            }
        fi
    else
        rm -f -- "$active"
    fi
    rm -rf -- "$final"
    exit 1
fi

if [[ "$with_integrations" == true ]]; then
    CLANKERHOUSE_BIN_DIR="$bin_dir" "$active/bin/clankerhouse-install-claude-hooks"
fi
if [[ "$with_systemd" == true ]]; then
    systemctl --user daemon-reload
    if [[ "$enable_services" == true ]]; then
        systemctl --user enable --now clankerhouse-recovery.service clankerhouse-resource-guard.service clankerhouse-spot-watch.service
    fi
fi

: > "$manifest_next"
[[ ! -f "$manifest" ]] || cat "$manifest" >> "$manifest_next"
record "$active"
[[ -z "$previous_target" ]] || record "$previous_target"
record "$final"
for command in "$final"/bin/*; do
    [[ -f "$command" && -x "$command" ]] && record "$bin_dir/$(basename "$command")"
done
if [[ "$with_integrations" == true ]]; then
    for destination in "${integration_destinations[@]}"; do record "$destination"; done
fi
if [[ "$with_systemd" == true ]]; then
    for template in "$final"/share/systemd/user/*.in; do record "$unit_dir/$(basename "${template%.in}")"; done
fi
awk '!seen[$0]++' "$manifest_next" > "$manifest_next.unique"
mv "$manifest_next.unique" "$manifest_next"
mv "$manifest_next" "$manifest"
trap - EXIT
printf 'Installed Clankerhouse version %s\n' "$version_id"
printf 'Active target: %s -> %s\n' "$active" "$final"
printf 'Add %s to PATH or load %s with TPM.\n' "$bin_dir" "$active/clankerhouse.tmux"
