#!/bin/bash
# Source from a standalone QA scenario to run it against a private, isolated Herdr
# server. Never touches the user's Herdr config, socket, or live server.
#
#   qa_herdr_start DIR   Start a server whose config and sockets live under DIR. Exports
#                        XDG_CONFIG_HOME, HERDR_CONFIG_PATH, HERDR_SOCKET_PATH,
#                        HERDR_CLIENT_SOCKET_PATH and HERDR_STARTUP_CWD, and sets
#                        qa_herdr_pid. Returns 77 when herdr is missing and
#                        HERDR_OPTIONAL is set, so callers can skip.
#   qa_herdr_stop        Stop exactly that server. Safe to call from an EXIT trap.
#   qa_herdr             Run the herdr CLI against the isolated server.

qa_herdr_bin=${HERDR_BIN:-$(command -v herdr || true)}
qa_herdr_pid=""
qa_herdr_sock=""

qa_herdr_start() {
    local dir=$1
    if [[ -z "$qa_herdr_bin" ]]; then
        if [[ -n "${HERDR_OPTIONAL:-}" ]]; then
            printf 'herdr binary not found; skipping (set HERDR_BIN to run it).\n' >&2
            return 77
        fi
        printf 'herdr binary not found; set HERDR_BIN or install herdr\n' >&2
        return 1
    fi
    mkdir -p "$dir/cfg/herdr" "$dir/home"
    # Herdr resolves its default server independently of XDG_CONFIG_HOME. Pin every
    # endpoint explicitly and run it in a private process group; otherwise a failed
    # isolated start followed by `server stop` can address the user's live server.
    export XDG_CONFIG_HOME="$dir/cfg"
    export HERDR_CONFIG_PATH="$dir/cfg/herdr/config.toml"
    export HERDR_SOCKET_PATH="$dir/cfg/herdr/herdr.sock"
    export HERDR_CLIENT_SOCKET_PATH="$dir/cfg/herdr/herdr-client.sock"
    export HERDR_STARTUP_CWD="$dir/home"
    qa_herdr_sock=$HERDR_SOCKET_PATH
    local live_sock="$HOME/.config/herdr/herdr.sock"
    [[ "$qa_herdr_sock" != "$live_sock" ]] || { printf 'Refusing live Herdr socket in standalone QA: %s\n' "$qa_herdr_sock" >&2; return 1; }
    setsid "$qa_herdr_bin" server >"$dir/herdr.log" 2>&1 &
    qa_herdr_pid=$!
    for _ in {1..200}; do
        [[ -S "$qa_herdr_sock" ]] && break
        kill -0 "$qa_herdr_pid" 2>/dev/null || break
        sleep 0.05
    done
    if [[ ! -S "$qa_herdr_sock" ]]; then
        printf 'isolated herdr server did not start at %s:\n' "$qa_herdr_sock" >&2
        cat "$dir/herdr.log" >&2
        return 1
    fi
    if [[ -S "$live_sock" && "$qa_herdr_sock" -ef "$live_sock" ]]; then
        printf 'Refusing isolated Herdr socket alias to live server: %s\n' "$qa_herdr_sock" >&2
        return 1
    fi
}

qa_herdr_stop() {
    [[ -n "$qa_herdr_pid" ]] || return 0
    # Never use `herdr server stop`: a mis-scoped client can resolve the live default
    # socket. Signal only the isolated process group, after revalidating its endpoint so
    # PID reuse cannot target another process.
    if [[ -r "/proc/$qa_herdr_pid/environ" ]] && tr '\0' '\n' <"/proc/$qa_herdr_pid/environ" | grep -Fqx "HERDR_SOCKET_PATH=$qa_herdr_sock"; then
        kill -TERM -- "-$qa_herdr_pid" 2>/dev/null || true
    fi
    wait "$qa_herdr_pid" 2>/dev/null || true
    qa_herdr_pid=""
}

qa_herdr() {
    HERDR_SOCKET_PATH="$qa_herdr_sock" "$qa_herdr_bin" "$@"
}
