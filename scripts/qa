      const [modulePath, socketPath, path] = process.argv.slice(1)
      const { getSnapshot, refreshProjection } = await import(modulePath)
      await refreshProjection(socketPath)
      const snapshot = await getSnapshot(socketPath)
      process.exit(snapshot.sessions.some((row) => row.path === path && row.target?.type === "directory") ? 0 : 1)
    ' "$repo/src/transport/index.ts" "$rtd/daemon.sock" "$sessionless_worktree" 2>/dev/null
    then
        sessionless_projected=1
        break
    fi
    sleep 0.05
done
