import os

lines = os.environ["LINEAGE_CAPTURE"].splitlines()
positions = {}
for name in (os.environ["LINEAGE_ROOT_SESSION"], os.environ["LINEAGE_FIX_COVERAGE_SESSION"], os.environ["LINEAGE_FIX_JAVA_SESSION"]):
    for index, line in enumerate(lines):
        if name in line:
            positions[name] = index
            break
    else:
        raise AssertionError(f"Missing {name!r} in capture")
assert positions[os.environ["LINEAGE_ROOT_SESSION"]] < positions[os.environ["LINEAGE_FIX_COVERAGE_SESSION"]] < positions[os.environ["LINEAGE_FIX_JAVA_SESSION"]], positions
def ordered(line, *tokens):
    cursor = -1
    for token in tokens:
        cursor = line.find(token, cursor + 1)
        if cursor < 0:
            return False
    return True

assert any(ordered(line, "✓", os.environ["LINEAGE_ROOT_SESSION"]) and "main" in line and "pi" in line for line in lines), lines
assert any(ordered(line, "├", "✓", os.environ["LINEAGE_FIX_COVERAGE_SESSION"]) for line in lines), lines
assert any(ordered(line, "└", "✓", os.environ["LINEAGE_FIX_JAVA_SESSION"]) for line in lines), lines
assert any(ordered(line, "·", "✓", "main") and "zsh" in line for line in lines), lines
assert any(ordered(line, "·", "✓", "pi") and "done" in line for line in lines), lines
PY
