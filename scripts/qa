    printf 'Lineage fixture ready. Attach with: tmux -S %s attach -t harness\n' "$outer_socket"
    printf 'Capture with: tmux -S %s capture-pane -p -J -t harness:client -S -200 > %s\n' "$outer_socket" "$lineage_capture_path"
    exit 0
