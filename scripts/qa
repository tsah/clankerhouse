#!/bin/bash

set -euo pipefail

uid=$(id -u)
root=$(realpath -m -- "${CLANKERHOUSE_QA_ROOT:-"/tmp/qa-clankerhouse-tree-$uid-$$"}")
if [[ ! "$root" =~ ^/tmp/qa-clankerhouse-[A-Za-z0-9._-]+$ ]]; then
    printf 'Refusing unsafe Clankerhouse QA root: %s\n' "$root" >&2
    exit 1
fi
qa_marker="$root.clankerhouse-qa-owned"
inner_socket="$root/inner.sock"
outer_socket="$root/outer.sock"
runtime="$root/runtime"
fixture_runtime="$root/fixture-runtime"
state_home="$root/state"
cache_file="$runtime/clankerhouse-$uid/state.json"
lineage_capture_path="$root/lineage-render.txt"
session="qa-workshop-tree"
repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

cleanup() {
    if [[ "${CLANKERHOUSE_QA_KEEP:-0}" == "1" ]]; then
        printf 'Retaining QA fixture at %s\n' "$root" >&2
        return
    fi
    server_pid_file="$runtime/clankerhouse-$uid/server.pid"
    if [[ -r "$server_pid_file" ]]; then
        server_pid=$(<"$server_pid_file")
        if [[ "$server_pid" =~ ^[0-9]+$ ]] && tr '\0' '\n' < "/proc/$server_pid/environ" 2>/dev/null | grep -Fx "XDG_RUNTIME_DIR=$runtime" >/dev/null; then
            kill "$server_pid" 2>/dev/null || true
        fi
    fi
    tmux -S "$outer_socket" kill-server 2>/dev/null || true
    tmux -S "$inner_socket" kill-server 2>/dev/null || true
    if [[ -f "$qa_marker" ]]; then
        rm -rf "$root"
    fi
}
trap cleanup EXIT INT TERM

capture_outer() {
    tmux -S "$outer_socket" capture-pane -p -J -t "$outer_pane" 2>/dev/null || true
}

wait_for_text() {
    local pattern=$1
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_outer)
        [[ "$capture" == *"$pattern"* ]] && return 0
        sleep 0.05
    done
    printf 'Timed out waiting for %q\n%s\n' "$pattern" "$capture" >&2
    return 1
}

wait_for_absent_text() {
    local pattern=$1
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_outer)
        [[ "$capture" != *"$pattern"* ]] && return 0
        sleep 0.05
    done
    printf 'Timed out waiting for %q to disappear\n%s\n' "$pattern" "$capture" >&2
    return 1
}

wait_for_row_glyph() {
    local pattern=$1
    local glyph=$2
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_outer)
        if ROW_PATTERN="$pattern" ROW_GLYPH="$glyph" CAPTURE="$capture" python3 - <<'PY'
import os

pattern = os.environ["ROW_PATTERN"]
glyph = os.environ["ROW_GLYPH"]
for line in os.environ["CAPTURE"].splitlines():
    if pattern in line and glyph in line.partition(pattern)[0]:
        raise SystemExit(0)
raise SystemExit(1)
PY
        then
            return 0
        fi
        sleep 0.05
    done
    printf 'Timed out waiting for glyph %q on row %q\n%s\n' "$glyph" "$pattern" "$capture" >&2
    return 1
}

wait_for_selected_row() {
    local pattern=$1
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_outer)
        if SELECTED_PATTERN="$pattern" CAPTURE="$capture" python3 - <<'PY'
import os

pattern = os.environ["SELECTED_PATTERN"]
for line in os.environ["CAPTURE"].splitlines():
    if '> ' not in line or 'targets' in line or line.rstrip().endswith('_'):
        continue
    prefix, _, remainder = line.partition('> ')
    if prefix.strip() in {'', '│'} and pattern in remainder:
        raise SystemExit(0)
raise SystemExit(1)
PY
        then
            return 0
        fi
        sleep 0.05
    done
    printf 'Timed out waiting for selected row %q\n%s\n' "$pattern" "$capture" >&2
    return 1
}

open_picker_window() {
    local name=$1
    tmux -S "$inner_socket" new-window -t "=$session" -n "$name" -c "$repo" "$picker_command"
    tmux -S "$inner_socket" display-message -p -t "=$session:$name" '#{pane_id}'
}

write_fixture_cache() {
    local variant=$1
    mkdir -p "$(dirname "$cache_file")"
    bun --eval '
      const { writeFileSync } = await import("node:fs")
      const [variant, file] = process.argv.slice(1)
      const detail = (session, title, suffix, state = "idle", kind = "window", status = kind === "window" ? "zsh" : state) => ({
        kind: ["pi", "claude", "opencode", "codex"].includes(kind) ? "clanker" : kind,
        harness: ["pi", "claude", "opencode", "codex"].includes(kind) ? kind : undefined,
        status,
        detail: "",
        title,
        age: "1m",
        state,
        target: kind === "opencode"
          ? { type: "opencode", session, pane: `%${suffix}` }
          : { type: "tmux_window", session, windowId: `@${suffix}`, pane: `%${suffix}` },
        completionKey: `${kind}:@${suffix}`,
        updatedAt: Number(suffix) || 0,
      })
      const session = (name, recency, overrides = {}) => ({
        name,
        path: `/tmp/${name}`,
        branch: name,
        flags: "clean",
        markers: [],
        age: "1m",
        recency,
        target: { type: "tmux_session", session: name },
        details: [detail(name, `${name}-main`, `${recency}`)],
        searchText: "",
        ...overrides,
      })
      const scrollRows = Array.from({ length: 40 }, (_, index) => session(`qa-scroll-${String(index).padStart(2, "0")}`, 600 - index))
      const searchRows = [
        session("z-root", 520, { workshopId: "z", lineageSearchText: "z root" }),
        session("false-positive", 519, { branch: "root", details: [detail("false-positive", "shell", "519")] }),
        session("search-root", 518, {
          workshopId: "search-root",
          childWorkshopCount: 1,
          lineageLabel: "⇣1",
          lineageSearchText: "search-root child-count-1",
          details: [detail("search-root", "root-main", "518"), detail("search-root", "root-log", "517")],
        }),
        session("search-child", 517, {
          workshopId: "search-child",
          parentWorkshopId: "search-root",
          details: [detail("search-child", "exact-hit", "516"), detail("search-child", "unrelated-log", "515")],
        }),
      ]
      const refreshInitial = [
        session("refresh-third", 430, { workshopId: "refresh-third" }),
        session("refresh-keep", 429, { workshopId: "refresh-keep" }),
        session("refresh-remove", 428, { workshopId: "refresh-remove" }),
      ]
      const refreshUpdated = [
        session("refresh-new-top", 500, { workshopId: "refresh-new-top" }),
        session("refresh-keep", 499, { workshopId: "refresh-keep" }),
      ]
      const lineageRoot = process.env.LINEAGE_ROOT_SESSION || "lineage-root"
      const lineageCoverage = process.env.LINEAGE_FIX_COVERAGE_SESSION || "lineage-coverage"
      const lineageJava = process.env.LINEAGE_FIX_JAVA_SESSION || "lineage-java"
      const lineageVisual = [
        session(lineageRoot, 620, {
          workshopId: "lineage-root",
          childWorkshopCount: 2,
          lineageLabel: "⇣2",
          lineageSearchText: "lineage-root child-count-2",
          details: [detail(lineageRoot, "main", "620", "idle"), detail(lineageRoot, "pi", "621", "done", "pi")],
        }),
        session(lineageCoverage, 619, {
          workshopId: "lineage-coverage",
          parentWorkshopId: "lineage-root",
          details: [detail(lineageCoverage, "main", "619", "idle"), detail(lineageCoverage, "pi", "618", "done", "pi")],
        }),
        session(lineageJava, 618, {
          workshopId: "lineage-java",
          parentWorkshopId: "lineage-root",
          details: [detail(lineageJava, "main", "617", "idle"), detail(lineageJava, "pi", "616", "done", "pi")],
        }),
      ]
      const rows = variant === "search"
        ? [session("qa-workshop-tree", 700), ...scrollRows, ...searchRows]
        : variant === "refresh-initial"
          ? refreshInitial
          : variant === "lineage-visual"
            ? lineageVisual
            : refreshUpdated
      writeFileSync(file, JSON.stringify({ version: 10, generatedAt: Date.now(), sessions: rows }))
    ' "$variant" "$cache_file"
}

pane_exists() {
    local pane=$1
    [[ "$(tmux -S "$inner_socket" display-message -p -t "$pane" '#{pane_id}' 2>/dev/null || true)" == "$pane" ]]
}

if [[ -e "$root" && ! -f "$qa_marker" ]]; then
    printf 'Refusing to replace unowned Clankerhouse QA root: %s\n' "$root" >&2
    exit 1
fi
rm -rf "$root"
mkdir -p "$runtime" "$state_home/clankerhouse/activity" "$root/zoxide" "$root/dev" "$root/bin"
touch "$qa_marker"

# Match the standalone launcher's non-login PATH.
# shellcheck source=/dev/null
. "$repo/libexec/clankerhouse-env"
real_wt=$(command -v wt)
cat > "$root/bin/wt" <<SH
#!/bin/bash
sleep 1
exec "$real_wt" "\$@"
SH
chmod +x "$root/bin/wt"

for recovery_repo in recovery-old recovery-durable recovery-edited; do
    recovery_path="$root/dev/$recovery_repo"
    git init -q -b main "$recovery_path"
    git -C "$recovery_path" config user.name "Clankerhouse QA"
    git -C "$recovery_path" config user.email "clankerhouse-qa@example.invalid"
    touch "$recovery_path/fixture"
    git -C "$recovery_path" add fixture
    GIT_AUTHOR_DATE="2000-01-01T00:00:00Z" GIT_COMMITTER_DATE="2000-01-01T00:00:00Z" git -C "$recovery_path" commit -qm "Initial fixture"
done
printf 'recent edit\n' > "$root/dev/recovery-edited/fixture"
mkdir -p "$root/recovery-ledger-only"
recovery_now=$(date +%s%3N)
printf '{"path":"%s","source":"opened","updatedAt":%s}\n' "$root/dev/recovery-durable" "$recovery_now" > "$state_home/clankerhouse/activity/recovery-durable.json"
printf '{"path":"%s","source":"clanker","updatedAt":%s}\n' "$root/recovery-ledger-only" "$recovery_now" > "$state_home/clankerhouse/activity/recovery-ledger-only.json"

lineage_origin="$root/lineage-origin"
lineage_root="$root/dev/idp-java"
lineage_fix_coverage="$root/dev/fix-coverage"
lineage_fix_java="$root/dev/fix-java"
lineage_root_session='tweezr@idp-java'
lineage_fix_coverage_session='tweezr@fix-coverage-hyphenation'
lineage_fix_java_session='tweezr@fix-java-failed-tests'
git init -q -b main "$lineage_origin"
git -C "$lineage_origin" config user.name "Clankerhouse QA"
git -C "$lineage_origin" config user.email "clankerhouse-qa@example.invalid"
touch "$lineage_origin/fixture"
git -C "$lineage_origin" add fixture
git -C "$lineage_origin" commit -qm "Initial fixture"
git -C "$lineage_origin" worktree add -q -b idp-java "$lineage_root"
git -C "$lineage_origin" worktree add -q -b fix-coverage "$lineage_fix_coverage"
git -C "$lineage_origin" worktree add -q -b fix-java "$lineage_fix_java"
lineage_tsv=$(LINEAGE_ROOT_SESSION="$lineage_root_session" LINEAGE_FIX_COVERAGE_SESSION="$lineage_fix_coverage_session" LINEAGE_FIX_JAVA_SESSION="$lineage_fix_java_session" XDG_STATE_HOME="$state_home" bun --eval '
  const [modulePath, rootPath, coveragePath, javaPath, dbPath] = process.argv.slice(1)
  const { identifyWorkshopSync, registerWorkshop } = await import(modulePath)
  const root = registerWorkshop(identifyWorkshopSync(rootPath), { dbPath })
  const coverage = registerWorkshop(identifyWorkshopSync(coveragePath), { dbPath, parentWorkshopId: root.workshopId })
  const java = registerWorkshop(identifyWorkshopSync(javaPath), { dbPath, parentWorkshopId: root.workshopId })
  console.log([
    [process.env.LINEAGE_ROOT_SESSION, rootPath, root.workshopId, root.parentWorkshopId ?? ""],
    [process.env.LINEAGE_FIX_COVERAGE_SESSION, coveragePath, coverage.workshopId, coverage.parentWorkshopId ?? ""],
    [process.env.LINEAGE_FIX_JAVA_SESSION, javaPath, java.workshopId, java.parentWorkshopId ?? ""],
  ].map((row) => row.join("\t")).join("\n"))
' "$repo/src/workshop.ts" "$lineage_root" "$lineage_fix_coverage" "$lineage_fix_java" "$state_home/clankerhouse/workshops.sqlite3")
while IFS=$'\t' read -r lineage_session lineage_path lineage_workshop lineage_parent; do
    [[ -n "$lineage_session" ]] || continue
    tmux -S "$inner_socket" -f /dev/null new-session -d -s "$lineage_session" -n main -x 140 -y 40 -c "$lineage_path" "sleep 300"
    tmux -S "$inner_socket" set-option -t "$lineage_session" @dotfiles_worktree_path "$lineage_path"
    tmux -S "$inner_socket" set-option -t "$lineage_session" @dotfiles_workshop_id "$lineage_workshop"
    tmux -S "$inner_socket" set-option -t "$lineage_session" @dotfiles_workshop_parent_id "$lineage_parent"
done <<< "$lineage_tsv"
for lineage_session in "$lineage_root_session" "$lineage_fix_coverage_session" "$lineage_fix_java_session"; do
    lineage_path=$(tmux -S "$inner_socket" show-option -qv -t "$lineage_session" @dotfiles_worktree_path)
    tmux -S "$inner_socket" new-window -d -t "$lineage_session" -n pi -c "$lineage_path" "sleep 300"
    tmux -S "$inner_socket" set-option -w -t "$lineage_session:pi" @dotfiles_harness pi
done
lineage_root_pi_pane=$(tmux -S "$inner_socket" display-message -p -t "$lineage_root_session:pi" '#{pane_id}')
lineage_fix_coverage_pi_pane=$(tmux -S "$inner_socket" display-message -p -t "$lineage_fix_coverage_session:pi" '#{pane_id}')
lineage_fix_java_pi_pane=$(tmux -S "$inner_socket" display-message -p -t "$lineage_fix_java_session:pi" '#{pane_id}')

tmux -S "$inner_socket" new-session -d -s "$session" -n qa-main -x 140 -y 40 -c "$root" "sleep 300"
tmux -S "$inner_socket" new-window -d -t "=$session" -n pi -c "$root" "sleep 300"
tmux -S "$inner_socket" set-option -w -t "=$session:pi" @dotfiles_harness pi
main_pane=$(tmux -S "$inner_socket" display-message -p -t "=$session:qa-main" '#{pane_id}')
pi_pane=$(tmux -S "$inner_socket" display-message -p -t "=$session:pi" '#{pane_id}')

recovery_json=$(env TMUX="$inner_socket,0,0" XDG_RUNTIME_DIR="$runtime" XDG_STATE_HOME="$state_home" _ZO_DATA_DIR="$root/zoxide" CLANKERHOUSE_DEV_ROOT="$root/dev" CLANKERHOUSE_OPENCODE_STATUS=/bin/true bun run "$repo/src/main.tsx" --dump-state)
RECOVERY_JSON="$recovery_json" RECOVERY_ROOT="$root/dev" LEDGER_ONLY="$root/recovery-ledger-only" python3 - <<'PY'
import json
import os

rows = json.loads(os.environ["RECOVERY_JSON"])
root = os.environ["RECOVERY_ROOT"]
paths = [row["path"] for row in rows]
old = f"{root}/recovery-old"
durable = f"{root}/recovery-durable"
edited = f"{root}/recovery-edited"
ledger_only = os.environ["LEDGER_ONLY"]
by_path = {row["path"]: row for row in rows}
assert by_path[durable]["activitySource"] == "opened", by_path[durable]
assert by_path[edited]["activitySource"] == "edited", by_path[edited]
assert by_path[ledger_only]["activitySource"] == "clanker", by_path[ledger_only]
assert paths.index(durable) < paths.index(old), paths
assert paths.index(edited) < paths.index(old), paths
assert paths.index(old) < paths.index(ledger_only), paths
PY

state_dir="$runtime/clankerhouse-$uid/clanker-state"
mkdir -p "$state_dir"
state_file="$state_dir/${pi_pane//[^A-Za-z0-9_.%-]/_}.json"
lineage_now=$(date +%s%3N)
for lineage_pane in "$lineage_root_pi_pane" "$lineage_fix_coverage_pi_pane" "$lineage_fix_java_pi_pane"; do
    lineage_state_file="$state_dir/${lineage_pane//[^A-Za-z0-9_.%-]/_}.json"
    printf '{"harness":"pi","state":"done","pane":"%s","updatedAt":%s,"hookEvent":"agent_settled"}\n' "$lineage_pane" "$lineage_now" > "$lineage_state_file"
done
env TMUX="$inner_socket,0,0" TMUX_PANE="$pi_pane" XDG_RUNTIME_DIR="$runtime" XDG_STATE_HOME="$state_home" "$repo/bin/clankerhouse-clanker-state-report" pi working </dev/null
[[ -s "$state_file" ]] || { printf 'Expected clanker state report for %s\n' "$pi_pane" >&2; exit 1; }
ACTIVITY_DIR="$state_home/clankerhouse/activity" ACTIVITY_PATH="$root" python3 - <<'PY'
import json
import os
from pathlib import Path

records = [json.loads(path.read_text()) for path in Path(os.environ["ACTIVITY_DIR"]).glob("*.json")]
assert any(record["path"] == os.environ["ACTIVITY_PATH"] and record["source"] == "clanker" for record in records), records
PY

tmux -S "$outer_socket" -f /dev/null new-session -d -s harness -n client -x 140 -y 40 \
    "env -u TMUX tmux -S '$inner_socket' attach-session -t '=$session'"
outer_pane=$(tmux -S "$outer_socket" list-panes -t harness:client -F '#{pane_id}')
# Match clankerhouse-picker. Depending on nested-tmux key handling, either
# server may see Alt-D first, so both must forward it to OpenTUI.
tmux -S "$outer_socket" set-option -gq @clankerhouse_open 1
tmux -S "$inner_socket" set-option -gq @clankerhouse_open 1
sleep 0.2

picker_command="env PATH='$root/bin:$PATH' XDG_RUNTIME_DIR='$runtime' XDG_STATE_HOME='$state_home' _ZO_DATA_DIR='$root/zoxide' CLANKERHOUSE_HOME='$repo' CLANKERHOUSE_BIN_DIR='$repo/bin' CLANKERHOUSE_LIBEXEC='$repo/libexec' CLANKERHOUSE_DEV_ROOT='$root/dev' CLANKERHOUSE_OPENCODE_STATUS=/bin/true '$repo/bin/clankerhouse-picker'"
tmux -S "$inner_socket" new-window -t "=$session" -n picker -c "$repo" "$picker_command"
animation_picker_pane=$(tmux -S "$inner_socket" display-message -p -t "=$session:picker" '#{pane_id}')
wait_for_text "qa-workshop-tree"
wait_for_text "edited"
wait_for_text "opened"
sleep 0.1
working_frame_one=$(tmux -S "$outer_socket" capture-pane -p -J -t "$outer_pane" -S -200)
sleep 0.25
working_frame_two=$(tmux -S "$outer_socket" capture-pane -p -J -t "$outer_pane" -S -200)
case "$working_frame_one" in
    *"⠋"*|*"⠙"*|*"⠹"*|*"⠸"*|*"⠼"*|*"⠴"*|*"⠦"*|*"⠧"*) ;;
    *) printf 'Expected a working spinner frame\n' >&2; exit 1 ;;
esac
[[ "$working_frame_one" != "$working_frame_two" ]] || { printf 'Expected the working spinner to animate\n' >&2; exit 1; }
tmux -S "$inner_socket" kill-pane -t "$animation_picker_pane"
sleep 0.2

now=$(date +%s%3N)
printf '{"harness":"pi","state":"blocked","pane":"%s","updatedAt":%s,"hookEvent":"question"}\n' "$pi_pane" "$now" > "$state_file"
rm -f "$runtime/clankerhouse-$uid/state.json"
tmux -S "$inner_socket" new-window -t "=$session" -n picker -c "$repo" "$picker_command"
attention_picker_pane=$(tmux -S "$inner_socket" display-message -p -t "=$session:picker" '#{pane_id}')
wait_for_text "qa-workshop-tree"
blink_visible=false
blink_hidden=false
for _ in {1..60}; do
    attention_frame=$(tmux -S "$outer_socket" capture-pane -p -J -t "$outer_pane" -S -200)
    if [[ "$attention_frame" == *"!"* ]]; then blink_visible=true; else blink_hidden=true; fi
    [[ "$blink_visible" == true && "$blink_hidden" == true ]] && break
    sleep 0.1
done
[[ "$blink_visible" == true && "$blink_hidden" == true ]] || { printf 'Expected the waiting indicator to blink\n' >&2; exit 1; }
tmux -S "$inner_socket" kill-pane -t "$attention_picker_pane"
sleep 0.2

rm -f "$cache_file"
lineage_picker_pane=$(open_picker_window lineage-picker)
wait_for_text "$lineage_root_session"
tmux -S "$outer_socket" send-keys -t "$outer_pane" -l "idp-java"
wait_for_text "$lineage_fix_coverage_session"
wait_for_text "$lineage_fix_java_session"
wait_for_absent_text "· ○ main"
lineage_search_frame=$(capture_outer)
LINEAGE_CAPTURE="$lineage_search_frame" LINEAGE_ROOT_SESSION="$lineage_root_session" LINEAGE_FIX_COVERAGE_SESSION="$lineage_fix_coverage_session" LINEAGE_FIX_JAVA_SESSION="$lineage_fix_java_session" python3 - <<'PY'
import os

lines = os.environ["LINEAGE_CAPTURE"].splitlines()
positions = {}
for name in (os.environ["LINEAGE_ROOT_SESSION"], os.environ["LINEAGE_FIX_COVERAGE_SESSION"], os.environ["LINEAGE_FIX_JAVA_SESSION"]):
    for index, line in enumerate(lines):
        if name in line:
            positions[name] = index
            break
    else:
        raise AssertionError(f"Missing {name!r} in capture")
assert positions[os.environ["LINEAGE_ROOT_SESSION"]] < positions[os.environ["LINEAGE_FIX_COVERAGE_SESSION"]] < positions[os.environ["LINEAGE_FIX_JAVA_SESSION"]], positions
assert any(("├" in line or "└" in line) and os.environ["LINEAGE_FIX_COVERAGE_SESSION"] in line for line in lines), lines
assert any(("├" in line or "└" in line) and os.environ["LINEAGE_FIX_JAVA_SESSION"] in line for line in lines), lines
assert all("· ○ main" not in line for line in lines), lines
PY
tmux -S "$inner_socket" kill-pane -t "$lineage_picker_pane"
sleep 0.2

# Synthetic contract fixtures use a separate runtime so the authoritative
# daemon cannot overwrite their one-time crash fallback.
cache_file="$fixture_runtime/clankerhouse-$uid/state.json"
mkdir -p "$(dirname "$cache_file")"
LINEAGE_ROOT_SESSION="$lineage_root_session" LINEAGE_FIX_COVERAGE_SESSION="$lineage_fix_coverage_session" LINEAGE_FIX_JAVA_SESSION="$lineage_fix_java_session" write_fixture_cache lineage-visual
# They never poll JSON and never compete with the authoritative test daemon.
picker_command="env PATH='$root/bin:$PATH' XDG_RUNTIME_DIR='$fixture_runtime' XDG_STATE_HOME='$state_home' _ZO_DATA_DIR='$root/zoxide' CLANKERHOUSE_HOME='$repo' CLANKERHOUSE_BIN_DIR='$repo/bin' CLANKERHOUSE_LIBEXEC='$repo/libexec' CLANKERHOUSE_DEV_ROOT='$root/dev' CLANKERHOUSE_OPENCODE_STATUS=/bin/true CLANKERHOUSE_SUBSCRIBE=0 CLANKERHOUSE_STARTUP_FALLBACK_ONLY=1 bun run '$repo/src/main.tsx'"
lineage_visual_pane=$(open_picker_window lineage-visual)
wait_for_text "$lineage_root_session"
# Select the exact lineage child independently of current-session priority,
# then clear the query while preserving its stable row anchor.
tmux -S "$outer_socket" send-keys -t "$outer_pane" -l "$lineage_fix_java_session"
wait_for_selected_row "$lineage_fix_java_session"
for ((i = 0; i < ${#lineage_fix_java_session}; i++)); do tmux -S "$outer_socket" send-keys -t "$outer_pane" BSpace; done
wait_for_selected_row "$lineage_fix_java_session"
tmux -S "$outer_socket" send-keys -t "$outer_pane" Right
wait_for_text "· ○ main"
wait_for_text "ready"
lineage_frame=$(capture_outer)
printf '%s\n' "$lineage_frame" > "$lineage_capture_path"
LINEAGE_CAPTURE="$lineage_frame" LINEAGE_ROOT_SESSION="$lineage_root_session" LINEAGE_FIX_COVERAGE_SESSION="$lineage_fix_coverage_session" LINEAGE_FIX_JAVA_SESSION="$lineage_fix_java_session" python3 - <<'PY'
import os

lines = os.environ["LINEAGE_CAPTURE"].splitlines()
positions = {}
for name in (os.environ["LINEAGE_ROOT_SESSION"], os.environ["LINEAGE_FIX_COVERAGE_SESSION"], os.environ["LINEAGE_FIX_JAVA_SESSION"]):
    for index, line in enumerate(lines):
        if name in line:
            positions[name] = index
            break
    else:
        raise AssertionError(f"Missing {name!r} in capture")
assert positions[os.environ["LINEAGE_ROOT_SESSION"]] < positions[os.environ["LINEAGE_FIX_COVERAGE_SESSION"]] < positions[os.environ["LINEAGE_FIX_JAVA_SESSION"]], positions
def ordered(line, *tokens):
    cursor = -1
    for token in tokens:
        cursor = line.find(token, cursor + 1)
        if cursor < 0:
            return False
    return True

assert any(ordered(line, "✓", os.environ["LINEAGE_ROOT_SESSION"]) and "main" in line and "pi" in line for line in lines), lines
assert any(ordered(line, "├", "✓", os.environ["LINEAGE_FIX_COVERAGE_SESSION"]) for line in lines), lines
assert any(ordered(line, "└", "✓", os.environ["LINEAGE_FIX_JAVA_SESSION"]) for line in lines), lines
assert any(ordered(line, "·", "○", "main") and "idle" in line and "├" not in line and "└" not in line for line in lines), lines
assert any(ordered(line, "·", "✓", "pi") and "ready" in line and "├" not in line and "└" not in line for line in lines), lines
PY
