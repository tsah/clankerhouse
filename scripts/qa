    if [[ ! -d "$async_worktree" ]] && ! workspace_exists "$async_ws"; then break; fi
    sleep 0.05
done
[[ ! -d "$async_worktree" ]] || { printf 'Deletion stopped when the picker exited\n' >&2; exit 1; }
if workspace_exists "$async_ws"; then printf 'Background deletion left its session alive\n' >&2; exit 1; fi
workspace_exists "$jump_ws" || { printf 'Background deletion closed the jump destination\n' >&2; exit 1; }
