#!/bin/bash
# Complete native TUI interaction scenario. The Workshop topology and the native client
# both live in a private, isolated Rex server; the client is driven through Rex's
# send/send-key and capture operations. Needs rex; skips without it unless REX_REQUIRED is set.

set -euo pipefail

uid=$(id -u)
repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# A fake Claude pane must never report the messaging socket of the Claude running this script.
unset CLAUDE_CODE_MESSAGING_SOCKET
unset HERDR_PANE_ID HERDR_ENV
# shellcheck source=lib/qa-rex-server
. "$repo/scripts/lib/qa-rex-server"

# Digits only after the prefix: a fuzzy query must never match letters of a random suffix in fixture paths.
root="/tmp/qa-tree-$uid-$$"
mkdir -m 700 "$root" || { printf 'Refusing to reuse Clankerhouse QA root: %s\n' "$root" >&2; exit 1; }
export CLANKERHOUSE_INSTANCE=qa-tree-$$
qa_rex_isolate "$root"
fixture_runtime="$root/fixture-runtime"
state_home="$XDG_STATE_HOME"
rtd=$qa_runtime
ch_state="$state_home/clankerhouse-$CLANKERHOUSE_INSTANCE"
cache_file="$rtd/state.json"
lineage_capture_path="$root/lineage-render.txt"
session="qa-workshop-tree"
export HOME="$root/home"
export _ZO_DATA_DIR="$root/zoxide"
export CLANKERHOUSE_HOME="$repo" CLANKERHOUSE_BIN_DIR="$repo/bin" CLANKERHOUSE_LIBEXEC="$repo/libexec"
# New Worktree fixtures must become visible immediately to the authoritative projection.
export CLANKERHOUSE_DIRECTORY_REFRESH_MS=1
export CLANKERHOUSE_OPENCODE_STATUS=/bin/true
QA_REX_ENV="_ZO_DATA_DIR"

cleanup() {
    if [[ "${CLANKERHOUSE_QA_KEEP:-0}" == "1" ]]; then
        printf 'Retaining QA fixture at %s (isolated Rex server %s)\n' "$root" "${qa_rex_sock:-}" >&2
        return
    fi
    "$repo/bin/clankerhouse-rex" --stop-runner >/dev/null 2>&1 || true
    qa_rex_stop
    rm -rf -- "$root"
}
trap cleanup EXIT INT TERM

json_field() { python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }
mux() { "$repo/bin/clankers" mux "$@"; }
# Session NAME with a first window WINDOW at CWD; prints "SESSION PANE".
spawn_session() {
    local out
    out=$(mux spawn --new-session "$1" --name "$2" --cwd "$3" -- sleep 300)
    printf '%s %s\n' "$(json_field nativeSessionId <<<"$out")" "$(json_field nativePaneId <<<"$out")"
}
# Window NAME in SESSION at CWD running ARGV...; prints its pane.
spawn_window() {
    local workspace=$1 name=$2 cwd=$3
    shift 3
    mux spawn --session "$workspace" --name "$name" --cwd "$cwd" -- "$@" | json_field nativePaneId
}
workspace_exists() { qa_rex session inspect "$1" >/dev/null 2>&1; }
pane_exists() { qa_rex block inspect -s "$qa_ws" "$1" >/dev/null 2>&1; }
# The block focused in SESSION's active window. Rex keeps focus per session; without an app client no session is "the" focused one.
focused_block() { qa_rex api call -s "$1" session.view '{}' | python3 -c 'import json,sys
view = json.load(sys.stdin)
print(next((w.get("focused_block_id") or "" for w in view["windows"] if w["window_id"] == view.get("active_window_id")), ""))'; }

capture_screen() {
    qa_rex capture -s "$qa_ws" -b "$picker_pane" 2>/dev/null || true
}
send_keys() { qa_rex send-key -s "$qa_ws" -b "$picker_pane" "$@" >/dev/null; }
send_text() { qa_rex send -s "$qa_ws" -b "$picker_pane" "$1" >/dev/null; }

wait_for_text() {
    local pattern=$1
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_screen)
        [[ "$capture" == *"$pattern"* ]] && return 0
        sleep 0.05
    done
    printf 'Timed out waiting for %q\n%s\n' "$pattern" "$capture" >&2
    return 1
}

wait_for_absent_text() {
    local pattern=$1
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_screen)
        [[ "$capture" != *"$pattern"* ]] && return 0
        sleep 0.05
    done
    printf 'Timed out waiting for %q to disappear\n%s\n' "$pattern" "$capture" >&2
    return 1
}

wait_for_row_glyph() {
    local pattern=$1
    local glyph=$2
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_screen)
        if ROW_PATTERN="$pattern" ROW_GLYPH="$glyph" CAPTURE="$capture" python3 - <<'PY'
import os

pattern = os.environ["ROW_PATTERN"]
glyph = os.environ["ROW_GLYPH"]
for line in os.environ["CAPTURE"].splitlines():
    if pattern in line and glyph in line.partition(pattern)[0]:
        raise SystemExit(0)
raise SystemExit(1)
PY
        then
            return 0
        fi
        sleep 0.05
    done
    printf 'Timed out waiting for glyph %q on row %q\n%s\n' "$glyph" "$pattern" "$capture" >&2
    return 1
}

wait_for_selected_row() {
    local pattern=$1
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_screen)
        if SELECTED_PATTERN="$pattern" CAPTURE="$capture" python3 - <<'PY'
import os

pattern = os.environ["SELECTED_PATTERN"]
for line in os.environ["CAPTURE"].splitlines():
    if pattern not in line or 'targets' in line or line.rstrip().endswith('_'):
        continue
    before = line.partition(pattern)[0]
    if '›' in before or '> ' in before:
        raise SystemExit(0)
raise SystemExit(1)
PY
        then
            return 0
        fi
        sleep 0.05
    done
    printf 'Timed out waiting for selected row %q\n%s\n' "$pattern" "$capture" >&2
    return 1
}

capture_view() {
    # Ignore blank-cell padding.
    capture_screen | python3 -c 'import sys; print("\n".join(line.rstrip() for line in sys.stdin.read().splitlines()).rstrip())'
}

wait_for_restored_view() {
    local expected=$1 capture=""
    for _ in {1..100}; do
        capture=$(capture_view)
        [[ "$capture" == "$expected" ]] && return 0
        sleep 0.05
    done
    printf 'Clearing search did not restore the original view\n' >&2
    diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$capture") >&2 || true
    return 1
}

wait_for_selected_detail() {
    local pattern=$1
    local capture=""
    for _ in {1..100}; do
        capture=$(capture_screen)
        if SELECTED_PATTERN="$pattern" CAPTURE="$capture" python3 - <<'PY'
import os

pattern = os.environ["SELECTED_PATTERN"]
for line in os.environ["CAPTURE"].splitlines():
    if pattern not in line or 'targets' in line or line.rstrip().endswith('_'):
        continue
    before = line.partition(pattern)[0]
    if ('›' in before or '> ' in before) and '·' in before:
        raise SystemExit(0)
raise SystemExit(1)
PY
        then
            return 0
        fi
        sleep 0.05
    done
    printf 'Timed out waiting for selected detail %q\n%s\n' "$pattern" "$capture" >&2
    return 1
}


# Open the native client as a new window of the current Workshop and make it the driven pane.
# Its exit status lands in picker-exit once it quits.
open_picker_window() {
    rm -f "$root/picker-exit"
    picker_pane=$(spawn_window "$qa_ws" "$1" "$repo" bash -c "$picker_command; echo \$? > '$root/picker-exit'")
}
# Quit the client like a user would.
close_picker() {
    pane_exists "$picker_pane" || return 0
    # Esc first clears any query, then closes.
    for _ in {1..4}; do
        send_keys escape 2>/dev/null || true
        for _ in {1..20}; do
            pane_exists "$picker_pane" || return 0
            sleep 0.05
        done
    done
    printf 'Native client pane %s did not close on Esc\n%s\n' "$picker_pane" "$(capture_screen)" >&2
    return 1
}

write_fixture_cache() {
    local variant=$1
    mkdir -p "$(dirname "$cache_file")"
    bun --eval '
      const { writeFileSync } = await import("node:fs")
      const [variant, file] = process.argv.slice(1)
      const detail = (session, title, suffix, state = "idle", kind = "window", status = kind === "window" ? "zsh" : state) => ({
        kind: ["pi", "claude", "opencode", "codex"].includes(kind) ? "clanker" : kind,
        harness: ["pi", "claude", "opencode", "codex"].includes(kind) ? kind : undefined,
        status,
        detail: "",
        title,
        age: "1m",
        state,
        target: kind === "opencode"
          ? { type: "opencode", session, pane: `p${suffix}` }
          : { type: "window", session, windowId: `t${suffix}`, pane: `p${suffix}` },
        completionKey: `${kind}:t${suffix}`,
        updatedAt: Number(suffix) || 0,
      })
      const session = (name, recency, overrides = {}) => ({
        name,
        path: `/tmp/${name}`,
        branch: name,
        flags: "clean",
        markers: [],
        age: "1m",
        recency,
        target: { type: "session", session: name },
        details: [detail(name, `${name}-main`, `${recency}`)],
        searchText: "",
        ...overrides,
      })
      const scrollRows = Array.from({ length: 40 }, (_, index) => session(`qa-scroll-${String(index).padStart(2, "0")}`, 600 - index))
      const searchRows = [
        session("z-root", 520, { workshopId: "z", lineageSearchText: "z root" }),
        session("false-positive", 519, { branch: "root", details: [detail("false-positive", "shell", "519")] }),
        session("search-root", 518, {
          workshopId: "search-root",
          childWorkshopCount: 1,
          lineageLabel: "⇣1",
          lineageSearchText: "search-root child-count-1",
          details: [detail("search-root", "root-main", "518"), detail("search-root", "root-log", "517")],
        }),
        session("search-child", 517, {
          workshopId: "search-child",
          parentWorkshopId: "search-root",
          details: [detail("search-child", "exact-hit", "516"), detail("search-child", "unrelated-log", "515")],
        }),
      ]
      const refreshInitial = [
        session("refresh-third", 430, { workshopId: "refresh-third" }),
        session("refresh-keep", 429, { workshopId: "refresh-keep" }),
        session("refresh-remove", 428, { workshopId: "refresh-remove" }),
      ]
      const refreshUpdated = [
        session("refresh-new-top", 500, { workshopId: "refresh-new-top" }),
        session("refresh-keep", 499, { workshopId: "refresh-keep" }),
      ]
      const lineageRoot = process.env.LINEAGE_ROOT_SESSION || "lineage-root"
      const lineageCoverage = process.env.LINEAGE_FIX_COVERAGE_SESSION || "lineage-coverage"
      const lineageJava = process.env.LINEAGE_FIX_JAVA_SESSION || "lineage-java"
      const lineageVisual = [
        session(lineageRoot, 620, {
          workshopId: "lineage-root",
          childWorkshopCount: 2,
          lineageLabel: "⇣2",
          lineageSearchText: "lineage-root child-count-2",
          details: [detail(lineageRoot, "main", "620", "idle"), detail(lineageRoot, "pi", "621", "done", "pi")],
        }),
        session(lineageCoverage, 617, {
          workshopId: "lineage-coverage",
          parentWorkshopId: "lineage-root",
          details: [detail(lineageCoverage, "main", "617", "idle"), detail(lineageCoverage, "pi", "616", "done", "pi")],
        }),
        session(lineageJava, 619, {
          workshopId: "lineage-java",
          parentWorkshopId: "lineage-root",
          details: [detail(lineageJava, "main", "619", "idle"), detail(lineageJava, "pi", "618", "done", "pi")],
        }),
      ]
      const largeCurrentLineage = [
        session("crowded-root", 800, { workshopId: "crowded-root" }),
        session("crowded-branch", 799, { workshopId: "crowded-branch", parentWorkshopId: "crowded-root" }),
        session("qa-workshop-tree", 100, { workshopId: "current", parentWorkshopId: "crowded-branch" }),
        ...Array.from({ length: 12 }, (_, index) => session(`crowded-sibling-${index}`, 600 - index, { parentWorkshopId: "crowded-branch" })),
      ]
      const neutralSort = [
        session("qa-workshop-tree", 1, { details: [] }),
        session("sort-directory", 500, { target: { type: "directory", path: "/tmp/sort-directory" }, details: [] }),
        session("sort-idle", 100, { details: [detail("sort-idle", "pi", "100", "idle", "pi")] }),
        session("sort-root", 50, { workshopId: "sort-root", details: [] }),
        session("sort-idle-child", 25, { parentWorkshopId: "sort-root", details: [detail("sort-idle-child", "pi", "25", "idle", "pi")] }),
        session("sort-neutral-child", 400, { parentWorkshopId: "sort-root", details: [] }),
      ]
      const rows = variant === "search"
        ? [session("qa-workshop-tree", 700), ...scrollRows, ...searchRows]
        : variant === "neutral-sort"
          ? neutralSort
        : variant === "large-current"
          ? largeCurrentLineage
        : variant === "refresh-initial"
          ? refreshInitial
          : variant === "lineage-visual"
            ? lineageVisual
            : refreshUpdated
      writeFileSync(file, JSON.stringify({ version: 11, generatedAt: Date.now(), sessions: rows }))
    ' "$variant" "$cache_file"
}

mkdir -p "$HOME" "$ch_state/activity" "$root/zoxide" "$root/dev" "$root/bin"

# Match the standalone launcher's non-login PATH.
# shellcheck source=/dev/null
. "$repo/libexec/clankerhouse-env"
real_wt=$(command -v wt)
cat > "$root/bin/wt" <<SH
#!/bin/bash
if [[ -f "$root/delete-paused" && " \$* " == *" remove "* ]]; then
    touch "$root/delete-started"
    while [[ -f "$root/delete-paused" ]]; do sleep 0.05; done
fi
sleep 1
exec "$real_wt" "\$@"
SH
chmod +x "$root/bin/wt"
# Synthetic fixtures paint only their cache file: this clankers computes no snapshot and runs no mutation.
cat > "$root/bin/fixture-clankers" <<'SH'
#!/bin/bash
[[ "$*" == "snapshot --watch" ]] && exec sleep 3600
exit 1
SH
chmod +x "$root/bin/fixture-clankers"
# Mutations the picker runs reach the held Worktrunk above.
export PATH="$root/bin:$PATH"

status=0; qa_rex_start "$root" || status=$?
[[ "$status" != 77 ]] || exit 0
[[ "$status" == 0 ]] || exit "$status"

for recovery_repo in recovery-old recovery-durable recovery-edited; do
    recovery_path="$root/dev/$recovery_repo"
    git init -q -b main "$recovery_path"
    git -C "$recovery_path" config user.name "Clankerhouse QA"
    git -C "$recovery_path" config user.email "clankerhouse-qa@example.invalid"
    touch "$recovery_path/fixture"
    git -C "$recovery_path" add fixture
    GIT_AUTHOR_DATE="2000-01-01T00:00:00Z" GIT_COMMITTER_DATE="2000-01-01T00:00:00Z" git -C "$recovery_path" commit -qm "Initial fixture"
done
printf 'recent edit\n' > "$root/dev/recovery-edited/fixture"

independent_repository="$root/dev/discovery-product"
nested_fixture_repository="$independent_repository/temp/cpw-fixture/popen-gw0/test_builder/repo"
git init -q -b main "$independent_repository"
git -C "$independent_repository" config user.name "Clankerhouse QA"
git -C "$independent_repository" config user.email "clankerhouse-qa@example.invalid"
touch "$independent_repository/fixture"
git -C "$independent_repository" add fixture
git -C "$independent_repository" commit -qm "Initial product fixture"
git init -q -b main "$nested_fixture_repository"
git -C "$nested_fixture_repository" config user.name "Clankerhouse QA"
git -C "$nested_fixture_repository" config user.email "clankerhouse-qa@example.invalid"
touch "$nested_fixture_repository/fixture"
git -C "$nested_fixture_repository" add fixture
git -C "$nested_fixture_repository" commit -qm "Nested test fixture"

# A linked worktree with no session. It exists before the first discovery: an open picker serves the
# directories discovered when it opened, and the runner rediscovers on its own slow schedule.
sessionless_worktree="$root/dev/qa-delete-sessionless"
sessionless_origin="$root/dev/lonely-origin"
git init -q -b main "$sessionless_origin"
git -C "$sessionless_origin" config user.name "Clankerhouse QA"
git -C "$sessionless_origin" config user.email "clankerhouse-qa@example.invalid"
touch "$sessionless_origin/fixture"
git -C "$sessionless_origin" add fixture
git -C "$sessionless_origin" commit -qm "Initial fixture"
git -C "$sessionless_origin" worktree add -q -b qa-delete-sessionless "$sessionless_worktree"

mkdir -p "$root/recovery-ledger-only"
recovery_now=$(date +%s%3N)
printf '{"path":"%s","source":"opened","updatedAt":%s}\n' "$root/dev/recovery-durable" "$recovery_now" > "$ch_state/activity/recovery-durable.json"
printf '{"path":"%s","source":"clanker","updatedAt":%s}\n' "$root/recovery-ledger-only" "$recovery_now" > "$ch_state/activity/recovery-ledger-only.json"

lineage_origin="$root/lineage-origin"
lineage_root="$root/dev/idp-java"
lineage_fix_coverage="$root/dev/fix-coverage"
lineage_fix_java="$root/dev/fix-java"
lineage_root_session='tweezr@idp-java'
lineage_fix_coverage_session='tweezr@fix-coverage-hyphenation'
lineage_fix_java_session='tweezr@fix-java-failed-tests'
git init -q -b main "$lineage_origin"
git -C "$lineage_origin" config user.name "Clankerhouse QA"
git -C "$lineage_origin" config user.email "clankerhouse-qa@example.invalid"
touch "$lineage_origin/fixture"
git -C "$lineage_origin" add fixture
git -C "$lineage_origin" commit -qm "Initial fixture"
git -C "$lineage_origin" worktree add -q -b idp-java "$lineage_root"
git -C "$lineage_origin" worktree add -q -b fix-coverage "$lineage_fix_coverage"
git -C "$lineage_origin" worktree add -q -b fix-java "$lineage_fix_java"
lineage_tsv=$(LINEAGE_ROOT_SESSION="$lineage_root_session" LINEAGE_FIX_COVERAGE_SESSION="$lineage_fix_coverage_session" LINEAGE_FIX_JAVA_SESSION="$lineage_fix_java_session" XDG_STATE_HOME="$state_home" bun --eval '
  const [modulePath, rootPath, coveragePath, javaPath, dbPath] = process.argv.slice(1)
  const { identifyWorkshopSync, registerWorkshop } = await import(modulePath)
  const root = registerWorkshop(identifyWorkshopSync(rootPath), { dbPath })
  const coverage = registerWorkshop(identifyWorkshopSync(coveragePath), { dbPath, parentWorkshopId: root.workshopId })
  const java = registerWorkshop(identifyWorkshopSync(javaPath), { dbPath, parentWorkshopId: root.workshopId })
  console.log([
    [process.env.LINEAGE_ROOT_SESSION, rootPath, root.workshopId, root.parentWorkshopId ?? ""],
    [process.env.LINEAGE_FIX_COVERAGE_SESSION, coveragePath, coverage.workshopId, coverage.parentWorkshopId ?? ""],
    [process.env.LINEAGE_FIX_JAVA_SESSION, javaPath, java.workshopId, java.parentWorkshopId ?? ""],
  ].map((row) => row.join("\t")).join("\n"))
' "$repo/src/workshop.ts" "$lineage_root" "$lineage_fix_coverage" "$lineage_fix_java" "$ch_state/workshops.sqlite3")
declare -A lineage_pi_panes=() lineage_sessions=()
while IFS=$'\t' read -r lineage_session lineage_path lineage_workshop lineage_parent; do
    [[ -n "$lineage_session" ]] || continue
    read -r lineage_ws _ < <(spawn_session "$lineage_session" main "$lineage_path")
    lineage_sessions[$lineage_session]=$lineage_ws
    mux claim --session "$lineage_ws" worktreePath "$lineage_path"
    mux claim --session "$lineage_ws" workshopId "$lineage_workshop"
    [[ -z "$lineage_parent" ]] || mux claim --session "$lineage_ws" workshopParentId "$lineage_parent"
    lineage_pi_panes[$lineage_session]=$(spawn_window "$lineage_ws" pi "$lineage_path" sleep 300)
    mux claim --pane "${lineage_pi_panes[$lineage_session]}" harness pi
done <<< "$lineage_tsv"
lineage_root_pi_pane=${lineage_pi_panes[$lineage_root_session]}
lineage_fix_coverage_pi_pane=${lineage_pi_panes[$lineage_fix_coverage_session]}
lineage_fix_java_pi_pane=${lineage_pi_panes[$lineage_fix_java_session]}

read -r qa_ws main_pane < <(spawn_session "$session" qa-main "$root")
pi_pane=$(spawn_window "$qa_ws" pi "$root" sleep 300)
mux claim --pane "$pi_pane" harness pi

recovery_json=$("$repo/bin/clankers" snapshot)
RECOVERY_JSON="$recovery_json" RECOVERY_ROOT="$root/dev" LEDGER_ONLY="$root/recovery-ledger-only" INDEPENDENT_REPOSITORY="$independent_repository" NESTED_FIXTURE_REPOSITORY="$nested_fixture_repository" python3 - <<'PY'
import json
import os

rows = json.loads(os.environ["RECOVERY_JSON"])["sessions"]
root = os.environ["RECOVERY_ROOT"]
paths = [row["path"] for row in rows]
old = f"{root}/recovery-old"
durable = f"{root}/recovery-durable"
edited = f"{root}/recovery-edited"
ledger_only = os.environ["LEDGER_ONLY"]
by_path = {row["path"]: row for row in rows}
assert by_path[durable]["activitySource"] == "opened", by_path[durable]
assert by_path[edited]["activitySource"] == "edited", by_path[edited]
assert by_path[ledger_only]["activitySource"] == "clanker", by_path[ledger_only]
assert os.environ["INDEPENDENT_REPOSITORY"] in paths, paths
assert os.environ["NESTED_FIXTURE_REPOSITORY"] not in paths, paths
assert paths.index(durable) < paths.index(old), paths
assert paths.index(edited) < paths.index(old), paths
assert paths.index(ledger_only) < paths.index(old), paths
PY

state_dir="$rtd/clanker-state"
mkdir -p "$state_dir"
state_file="$state_dir/${pi_pane//[^A-Za-z0-9_.%-]/_}.json"
lineage_now=$(date +%s%3N)
for lineage_pane in "$lineage_root_pi_pane" "$lineage_fix_coverage_pi_pane" "$lineage_fix_java_pi_pane"; do
    lineage_state_file="$state_dir/${lineage_pane//[^A-Za-z0-9_.%-]/_}.json"
    printf '{"harness":"pi","state":"done","pane":"%s","updatedAt":%s,"hookEvent":"agent_settled"}\n' "$lineage_pane" "$lineage_now" > "$lineage_state_file"
done
(cd "$root" && env REX_BLOCK="$pi_pane" REX_SESSION="$qa_ws" "$repo/bin/clankerhouse-clanker-state-report" pi working </dev/null)
[[ -s "$state_file" ]] || { printf 'Expected clanker state report for %s\n' "$pi_pane" >&2; exit 1; }
ACTIVITY_DIR="$ch_state/activity" ACTIVITY_PATH="$root" python3 - <<'PY'
import json
import os
from pathlib import Path

records = [json.loads(path.read_text()) for path in Path(os.environ["ACTIVITY_DIR"]).glob("*.json")]
assert any(record["path"] == os.environ["ACTIVITY_PATH"] and record["source"] == "clanker" for record in records), records
PY

# The server's terminals already carry this lane's XDG_*, CLANKERHOUSE_* and PATH.
live_picker_command="env CLANKERHOUSE_CURRENT_SESSION='$session' '$repo/bin/clankerhouse-rex'"
picker_command=$live_picker_command
open_picker_window picker
wait_for_text "qa-workshop-tree"
wait_for_text "edited"
wait_for_text "opened"
sleep 0.1
working_frame=$(capture_screen)
[[ "$working_frame" == *[◐◓◑◒]* ]] || { printf 'Expected the animated working orb\n' >&2; exit 1; }
close_picker

now=$(date +%s%3N)
jq --argjson now "$now" '.state = "blocked" | .updatedAt = $now | .hookEvent = "question"' "$state_file" > "$state_file.tmp"
mv "$state_file.tmp" "$state_file"
# The watched snapshot follows the clanker-state directory; nothing needs a refresh.
open_picker_window picker
wait_for_text "qa-workshop-tree"
attention_row=""
for _ in {1..60}; do
    attention_frame=$(capture_screen)
    attention_row=$(grep -F "qa-workshop-tree" <<<"$attention_frame" | head -n 1)
    [[ "$attention_row" == *"▲"* ]] && break
    sleep 0.1
done
[[ "$attention_row" == *"▲"* ]] || { printf 'Expected the static blocked glyph on qa-workshop-tree, last row: %s\n' "$attention_row" >&2; exit 1; }
close_picker

rm -f "$cache_file"
open_picker_window lineage-picker
wait_for_text "$lineage_root_session"
# Match both descendants so the native renderer must retain their shared ancestor context.
