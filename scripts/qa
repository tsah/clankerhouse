done
[[ "$active" == "$jump_session" && -d "$async_worktree" ]] || { printf 'Picker did not jump before deletion completed\n' >&2; exit 1; }
tmux -S "$inner_socket" has-session -t "=$async_session" || { printf 'Delete fixture completed before jump\n' >&2; exit 1; }
rm "$root/delete-paused"
for _ in {1..160}; do
    if [[ ! -d "$async_worktree" ]] && ! tmux -S "$inner_socket" has-session -t "=$async_session" 2>/dev/null; then break; fi
    sleep 0.05
done
[[ ! -d "$async_worktree" ]] || { printf 'Deletion stopped when the picker exited\n' >&2; exit 1; }
if tmux -S "$inner_socket" has-session -t "=$async_session" 2>/dev/null; then printf 'Background deletion left its session alive\n' >&2; exit 1; fi
tmux -S "$inner_socket" has-session -t "=$jump_session" || { printf 'Background deletion closed the jump destination\n' >&2; exit 1; }
git -C "$origin" show-ref --verify --quiet refs/heads/qa-delete-async || { printf 'Background deletion removed branch history\n' >&2; exit 1; }

printf 'Clankerhouse QA passed: neutral-last bottom-up ordering with last-seen priority within each group, durable recovery ordering, nested fixture repository exclusion, long-list scrolling, typed and bracketed-paste search, no-match Enter, socket-authoritative updates with one-time fallback, connector-aligned colored state glyphs, compact lineage-only connectors, inline summary names, expanded detail bullets, static Herdr status symbols, focus acknowledgement, persistent picker state, confirmed pane/final-worktree/parent-worktree/sessionless-worktree destruction, and jumping away during daemon-owned deletion behave correctly.\n'
