#!/bin/bash

set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
uid=$(id -u)
root=$(mktemp -d "/tmp/qa-clankerhouse-client-routing-$uid-XXXXXX")
inner_socket="$root/inner.sock"
outer_socket="$root/outer.sock"
state_home="$root/state"
runtime="$root/runtime"
qa_home="$root/home"
daemon_pid=""

cleanup() {
    if [[ -n "$daemon_pid" ]]; then kill "$daemon_pid" 2>/dev/null || true; wait "$daemon_pid" 2>/dev/null || true; fi
    tmux -S "$outer_socket" kill-server 2>/dev/null || true
    tmux -S "$inner_socket" kill-server 2>/dev/null || true
    rm -rf "$root"
}
trap cleanup EXIT INT TERM

mkdir -p "$state_home" "$runtime" "$qa_home"
chmod 700 "$state_home" "$runtime" "$qa_home"

tmux -S "$inner_socket" -f /dev/null new-session -d -s qa-launcher -n shell -x 100 -y 30 "sleep 300"
tmux -S "$inner_socket" new-session -d -s qa-requester -n shell -x 100 -y 30 "sleep 300"
tmux -S "$inner_socket" new-session -d -s qa-child -n shell -x 100 -y 30 "sleep 300"
tmux -S "$inner_socket" set-option -g @clankerhouse_server_epoch qa-client-routing-epoch

tmux -S "$outer_socket" -f /dev/null new-session -d -s harness -n launcher -x 100 -y 30 \
    "env -u TMUX tmux -S '$inner_socket' attach-session -t qa-launcher"
tmux -S "$outer_socket" new-window -d -t harness -n requester \
    "env -u TMUX tmux -S '$inner_socket' attach-session -t qa-requester"

launcher_client=""
requester_client=""
for _ in {1..100}; do
    while IFS='|' read -r client session; do
        [[ "$session" == qa-launcher ]] && launcher_client=$client
        [[ "$session" == qa-requester ]] && requester_client=$client
    done < <(tmux -S "$inner_socket" list-clients -F '#{client_name}|#{client_session}' 2>/dev/null || true)
    [[ -n "$launcher_client" && -n "$requester_client" ]] && break
    sleep 0.05
done
[[ -n "$launcher_client" && -n "$requester_client" && "$launcher_client" != "$requester_client" ]]

env \
    HOME="$qa_home" XDG_RUNTIME_DIR="$runtime" XDG_STATE_HOME="$state_home" \
    CLANKERHOUSE_HOME="$repo" CLANKERHOUSE_REFRESH_MS=100 \
    TMUX="$inner_socket,0,0" \
    "$repo/bin/clankerhouse-picker" --server >"$root/daemon.log" 2>&1 &
daemon_pid=$!
daemon_socket="$runtime/clankerhouse-$uid/daemon.sock"
for _ in {1..200}; do
    [[ -S "$daemon_socket" ]] && break
    kill -0 "$daemon_pid" 2>/dev/null || { cat "$root/daemon.log" >&2; exit 1; }
    sleep 0.05
done
[[ -S "$daemon_socket" ]] || { cat "$root/daemon.log" >&2; exit 1; }

client_session() {
    tmux -S "$inner_socket" list-clients -F '#{client_name}|#{session_name}' | awk -F '|' -v client="$1" '$1 == client { print $2 }'
}

target=$(jq -cn '{type:"tmux_session",session:"qa-child"}')
env \
    HOME="$qa_home" XDG_RUNTIME_DIR="$runtime" XDG_STATE_HOME="$state_home" \
    CLANKERHOUSE_HOME="$repo" TMUX="$inner_socket,0,0" \
    "$repo/bin/clankers" target open --json "$target" --client "$requester_client"

for _ in {1..100}; do
    [[ "$(client_session "$requester_client")" == qa-child ]] && break
    sleep 0.05
done
[[ "$(client_session "$requester_client")" == qa-child ]]
if [[ "$(client_session "$launcher_client")" != qa-launcher ]]; then
    tmux -S "$inner_socket" list-clients -F '#{client_name}|#{session_name}' >&2
    python3 - "$state_home/clankerhouse/registry.sqlite3" <<'PY' >&2
import sqlite3,sys
c=sqlite3.connect(sys.argv[1]); print(c.execute("select input,error from operations order by created_at desc limit 1").fetchone()); c.close()
PY
    exit 1
fi

printf 'Clankerhouse client-routing QA passed: an explicit requester switched to the child while the daemon launcher client stayed put.\n'
