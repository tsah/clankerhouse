#!/bin/bash

# Attach and delete-lineage actions on a private Rex server: attach candidates need no repository cache, deleting a
# middle Workshop splices its child to the surviving parent everywhere, and the CLI detaches and reparents.
set -euo pipefail

uid=$(id -u)
root=$(realpath -m -- "${CLANKERHOUSE_QA_ROOT:-"/tmp/qa-clankerhouse-lineage-actions-$uid-$$"}")
if [[ ! "$root" =~ ^/tmp/qa-clankerhouse-[A-Za-z0-9._-]+$ ]]; then
    printf 'Refusing unsafe Clankerhouse lineage-actions QA root: %s\n' "$root" >&2
    exit 1
fi
marker="$root.clankerhouse-qa-owned"
repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# shellcheck source=lib/qa-rex-server
. "$repo/scripts/lib/qa-rex-server"

cleanup() {
    qa_rex_stop
    if [[ -f "$marker" ]]; then rm -rf "$root"; rm -f "$marker"; fi
}
trap cleanup EXIT INT TERM

if [[ -e "$root" && ! -f "$marker" ]]; then
    printf 'Refusing to replace unowned Clankerhouse lineage-actions QA root: %s\n' "$root" >&2
    exit 1
fi
rm -rf "$root"
mkdir -p "$root/home" "$root/dev"
touch "$marker"
export HOME="$root/home" CLANKERHOUSE_HOME="$repo" CLANKERHOUSE_DEV_ROOT="$root/dev" CLANKERHOUSE_INSTANCE=qa-lineage-$$ CLANKERHOUSE_OPENCODE_STATUS=/bin/true
qa_rex_isolate "$root"
runtime=$qa_runtime

origin="$root/dev/repository"
parent_path="$origin"
middle_path="$root/dev/middle"
child_path="$root/dev/child"
git init -q -b main "$origin"
git -C "$origin" config user.name "Clankerhouse QA"
git -C "$origin" config user.email "clankerhouse-qa@example.invalid"
printf 'fixture\n' > "$origin/fixture"
git -C "$origin" add fixture
git -C "$origin" commit -qm "Initial fixture"
git -C "$origin" worktree add -q -b middle "$middle_path"
git -C "$origin" worktree add -q -b child "$child_path"

lineage=$(bun --eval '
  const [modulePath, parentPath, middlePath, childPath] = process.argv.slice(1)
  const { identifyWorkshopSync, registerWorkshop } = await import(modulePath)
  const parent = registerWorkshop(identifyWorkshopSync(parentPath))
  const middle = registerWorkshop(identifyWorkshopSync(middlePath), { parentWorkshopId: parent.workshopId })
  const child = registerWorkshop(identifyWorkshopSync(childPath), { parentWorkshopId: middle.workshopId })
  console.log(JSON.stringify({ parent, middle, child }))
' "$repo/src/workshop.ts" "$parent_path" "$middle_path" "$child_path")
parent_id=$(jq -r '.parent.workshopId' <<<"$lineage")
middle_id=$(jq -r '.middle.workshopId' <<<"$lineage")
child_id=$(jq -r '.child.workshopId' <<<"$lineage")

clankers() { "$repo/bin/clankers" "$@"; }
workspace_id() {
    clankers mux observe | jq -r --arg name "$1" '.sessions[] | select(.nativeName == $name) | .id'
}
create_session() {
    local name=$1 path=$2 workshop_id=$3 parent_workshop_id=$4 id
    id=$(clankers mux spawn --new-session "$name" --cwd "$path" -- sleep 3600 | jq -r .nativeSessionId)
    clankers mux claim --session "$id" worktreePath "$path"
    clankers mux claim --session "$id" workshopId "$workshop_id"
    if [[ -n "$parent_workshop_id" ]]; then
        clankers mux claim --session "$id" workshopParentId "$parent_workshop_id"
    fi
}
status=0
qa_rex_start "$root" || status=$?
[[ "$status" != 77 ]] || exit 0
[[ "$status" == 0 ]] || exit "$status"
create_session qa-parent "$parent_path" "$parent_id" ""
create_session qa-middle "$middle_path" "$middle_id" "$parent_id"
create_session qa-child "$child_path" "$child_id" "$middle_id"

# No repository picker cache is created. Attachment eligibility must arrive in the snapshot the native TUI client reads.
[[ ! -e "$runtime/repositories.json" ]] || { printf 'Unexpected repository picker cache in isolated attachment scenario\n' >&2; exit 1; }
snapshot_row() { clankers snapshot | jq -c --arg id "$1" '.sessions[] | select(.workshopId == $id)'; }
child_row=$(snapshot_row "$child_id")
[[ -n "$child_row" ]] || { printf 'child Workshop was not in the snapshot\n' >&2; exit 1; }
candidates=$(jq -c '.attachmentCandidateWorkshopIds' <<<"$child_row")
[[ "$candidates" == "[\"$parent_id\"]" ]] || { printf 'Expected cache-independent parent candidate %s, got %s\n' "$parent_id" "$candidates" >&2; exit 1; }
[[ ! -e "$runtime/repositories.json" ]] || { printf 'A snapshot wrote the repository picker cache\n' >&2; exit 1; }

clankers mutate --json "$(jq -cn --arg path "$middle_path" '{type: "delete", kind: "worktree", session: "qa-middle", path: $path, confirmed: true}')" >/dev/null

[[ ! -d "$middle_path" ]] || { printf 'Expected deleted middle worktree to be absent\n' >&2; exit 1; }
[[ -z "$(workspace_id qa-middle)" ]] || { printf 'Expected deleted middle session to be absent\n' >&2; exit 1; }
child_session=$(workspace_id qa-child)
[[ -n "$child_session" ]] || { printf 'Expected child session to survive\n' >&2; exit 1; }

db="$XDG_STATE_HOME/clankerhouse-$CLANKERHOUSE_INSTANCE/workshops.sqlite3"
actual_parent=$(sqlite3 "$db" "select coalesce(parent_id, '') from workshops where id = '$child_id';")
removed=$(sqlite3 "$db" "select count(*) from workshops where id = '$middle_id';")
claimed_parent=$(clankers mux read-claim --session "$child_session" workshopParentId)
manifest_parent=$(jq -r '.parentWorkshopId // ""' "$child_path/.clankerhouse/workshop.json")
[[ "$actual_parent" == "$parent_id" ]] || { printf 'Expected child DB parent %s, got %s\n' "$parent_id" "$actual_parent" >&2; exit 1; }
[[ "$removed" == 0 ]] || { printf 'Expected deleted middle Workshop declaration to be removed\n' >&2; exit 1; }
[[ "$claimed_parent" == "$parent_id" ]] || { printf 'Expected child session parent claim %s, got %s\n' "$parent_id" "$claimed_parent" >&2; exit 1; }
[[ "$manifest_parent" == "$parent_id" ]] || { printf 'Expected child manifest parent %s, got %s\n' "$parent_id" "$manifest_parent" >&2; exit 1; }

snapshot_parent=$(snapshot_row "$child_id" | jq -r '.parentWorkshopId // ""')
[[ "$snapshot_parent" == "$parent_id" ]] || { printf 'Expected projected child parent %s, got %s\n' "$parent_id" "$snapshot_parent" >&2; exit 1; }

# The CLI moves a parent link in-process, so the registry, manifest, and session claim agree.
expect_parent() {
    local want=$1 actual
    actual=$(sqlite3 "$db" "select coalesce(parent_id, '') from workshops where id = '$child_id';")
    [[ "$actual" == "$want" ]] || { printf 'Expected child DB parent %s, got %s\n' "$want" "$actual" >&2; exit 1; }
    actual=$(jq -r '.parentWorkshopId // ""' "$child_path/.clankerhouse/workshop.json")
    [[ "$actual" == "$want" ]] || { printf 'Expected child manifest parent %s, got %s\n' "$want" "$actual" >&2; exit 1; }
    actual=$(clankers mux read-claim --session "$child_session" workshopParentId)
    [[ "$actual" == "$want" ]] || { printf 'Expected child session parent claim %s, got %s\n' "$want" "$actual" >&2; exit 1; }
}
expect_rejected() {
    local want=$1 output
    shift
    if output=$(clankers "$@" 2>&1); then printf 'Expected rejection of: %s\n' "$*" >&2; exit 1; fi
    [[ "$output" == *"$want"* ]] || { printf 'Expected %s in: %s\n' "$want" "$output" >&2; exit 1; }
}

expect_rejected "Unknown workshop" workshop detach no-such-workshop
expect_rejected "Unknown workshop" workshop reparent "$child_id" --parent no-such-workshop
expect_rejected "--parent is required" workshop reparent "$child_id"
expect_rejected "unsafe lineage" workshop reparent "$child_id" --parent "$child_id"
expect_rejected "unsafe lineage" workshop reparent "$parent_id" --parent "$child_id"
expect_parent "$parent_id"

detached=$(clankers workshop detach "$child_id")
jq -e --arg id "$child_id" --arg old "$parent_id" '.workshopId == $id and .parentWorkshopId == null and .previousParentWorkshopId == $old and .changed == true' <<<"$detached" >/dev/null
expect_parent ""
jq -e '.changed == false' <<<"$(clankers workshop detach "$child_path")" >/dev/null

jq -e --arg old "$parent_id" '.parentWorkshopId == $old and .previousParentWorkshopId == null and .changed == true' <<<"$(cd "$child_path" && clankers workshop reparent --parent main)" >/dev/null
expect_parent "$parent_id"

jq -e '.parentWorkshopId == null' <<<"$(clankers workshop detach --cwd "$child_path")" >/dev/null
expect_parent ""
[[ "$(workspace_id qa-child)" == "$child_session" ]] || { printf 'Expected the child session to survive detach\n' >&2; exit 1; }

printf 'Clankerhouse lineage actions QA passed: attach candidates require no repository cache, and one middle-Workshop delete immediately splices its child declaration, manifest, session claim, and projection to the available parent; the CLI detaches and reparents and rejects cycles and unknown Workshops.\n'
