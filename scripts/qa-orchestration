#!/bin/bash

# Orchestration API end to end on a private Rex server under scratch XDG directories: a child clanker reports to its
# parent Workshop, the parent's resumable watch wakes on reports, settles, staleness, spawns, and exits exactly once,
# and a clanker's own Routine survives a runner restart and wakes it.
# Needs rex; skips without it unless REX_REQUIRED is set. Never touches the account's own Rex server or Clankerhouse state.
set -euo pipefail
# `clankers report` reads its payload from a non-terminal stdin; never wait on the caller's.
exec </dev/null

repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# shellcheck source=lib/qa-rex-server
. "$repo/scripts/lib/qa-rex-server"
root=$(mktemp -d /tmp/qa-orchestration.XXXXXX)
# A fake Claude pane must never report the messaging socket of the Claude running this script.
unset CLAUDE_CODE_MESSAGING_SOCKET CLANKER_ID CLANKERHOUSE_WORKSHOP_ID CLANKERHOUSE_PARENT_WORKSHOP_ID
export CLANKERHOUSE_INSTANCE=qa-orch-$$
qa_rex_isolate "$root"
runtime=$qa_runtime
mkdir -p "$root/home"
qa_env=(env "CLANKERHOUSE_HOME=$repo" "CLANKERHOUSE_BIN_DIR=" "CLANKERHOUSE_LIBEXEC=" "HOME=$root/home"
    "REX_BLOCK=" "CLANKER_ID=" "CLANKERHOUSE_WORKSHOP_ID=" "CLANKERHOUSE_PARENT_WORKSHOP_ID=")
watch_pid=""
inbox_pid=""

cleanup() {
    for pid in "$watch_pid" "$inbox_pid"; do
        if [[ -n "$pid" ]]; then kill -TERM "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
    done
    "${qa_env[@]}" "$repo/bin/clankerhouse-rex" --stop-runner >/dev/null 2>&1 || true
    qa_rex_stop
    rm -rf -- "$root"
}
trap cleanup EXIT INT TERM
rex_status=0
qa_rex_start "$root" || rex_status=$?
[[ "$rex_status" != 77 ]] || exit 0
[[ "$rex_status" == 0 ]] || exit "$rex_status"

fail() { echo "Clankerhouse orchestration QA failed: $*" >&2; exit 1; }
json_assert() {
    python3 -c 'import json,sys; text=sys.stdin.read(); data=[json.loads(line) for line in text.splitlines() if line.strip()] if sys.argv[2:]==["lines"] else json.loads(text); assert eval(sys.argv[1], {"data": data}), (sys.argv[1], data)' "$@"
}

api() { "${qa_env[@]}" "$repo/bin/clankers" "$@"; }
mux() { api mux "$@"; }
json_field() { python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }
hook() { local pane=$1 clanker=$2 state=$3 payload=$4; printf '%s' "$payload" | "${qa_env[@]}" env REX_BLOCK="$pane" CLANKER_ID="$clanker" "$repo/bin/clankerhouse-clanker-state-report" claude "$state"; }

# One repository with three Workshops: parent -> child -> grandchild.
parent="$root/repo"
git init -q -b main "$parent"
git -C "$parent" -c user.name=QA -c user.email=qa@example.invalid commit -qm fixture --allow-empty
git -C "$parent" worktree add -q -b child "$root/child"
git -C "$parent" worktree add -q -b grandchild "$root/grandchild"
lineage=$("${qa_env[@]}" bun --eval '
  const [modulePath, parent, child, grandchild] = process.argv.slice(1)
  const { identifyWorkshopSync, registerWorkshop } = await import(modulePath)
  const p = registerWorkshop(identifyWorkshopSync(parent), { parentWorkshopId: null })
  const c = registerWorkshop(identifyWorkshopSync(child), { parentWorkshopId: p.workshopId })
  const g = registerWorkshop(identifyWorkshopSync(grandchild), { parentWorkshopId: c.workshopId })
  console.log([p.workshopId, c.workshopId, g.workshopId].join(" "))
' "$repo/src/workshop.ts" "$parent" "$root/child" "$root/grandchild")
read -r parent_id child_id grandchild_id <<<"$lineage"
[[ -n "$grandchild_id" ]] || fail "lineage fixture was not registered"

claude_pane() {
    local session=$1 path=$2 clanker=$3
    local spawned pane native_session
    spawned=$(mux spawn --new-session "$session" --name claude --cwd "$path" -- sleep 600)
    native_session=$(json_field nativeSessionId <<<"$spawned")
    mux claim --session "$native_session" worktreePath "$path"
    pane=$(json_field nativePaneId <<<"$spawned")
    mux claim --pane "$pane" harness claude
    mux claim --pane "$pane" clankerId "$clanker"
    printf '%s %s' "$native_session" "$pane"
}
parent_session=$(mux spawn --new-session qa-parent --name main --cwd "$parent" -- sleep 600 | json_field nativeSessionId)
mux claim --session "$parent_session" worktreePath "$parent"
read -r child_session child_pane <<<"$(claude_pane qa-child "$root/child" clanker-qa-child)"
hook "$child_pane" clanker-qa-child idle '{"hook_event_name":"SessionStart"}'

# The runner does the timed work (Routines); everything else here runs in the CLI with no background process.
start_runner() { "${qa_env[@]}" "$repo/bin/clankerhouse-rex" --ensure-runner || { cat "$runtime/runner.log" >&2; fail "runner did not start"; }; }
stop_runner() { "${qa_env[@]}" "$repo/bin/clankerhouse-rex" --stop-runner; }

cursor="$root/orchestrator/watch.cursor"
watch_once() { (cd "$parent" && api watch --children-of . --descendants --cursor-file "$cursor" --once "$@"); }
expect_timeout() {
    set +e
    local output; output=$(watch_once --timeout "${1:-1}" 2>"$root/watch.err"); local code=$?
    set -e
    [[ $code -eq 124 ]] || fail "watch exited $code, expected timeout 124; output: $output; stderr: $(cat "$root/watch.err")"
    [[ -z "$output" ]] || fail "watch repeated or invented events: $output"
    json_assert 'data["error"]["code"] == "TIMEOUT"' <"$root/watch.err"
}

# The first re-armable watch starts from now and records its baseline immediately.
expect_timeout 1
[[ -f "$cursor" ]] || fail "watch did not persist its starting cursor"
echo "PASS: watch starts from now and persists its cursor"

# A1: a child reports to its parent by default; --to and --no-parent override; payloads validated.
report() { (cd "$root/child" && "${qa_env[@]}" env CLANKER_ID=clanker-qa-child "$repo/bin/clankers" report "$@"); }
report --state question --message "Which retention?" --payload '{"options":["7d","30d"],"recommendation":"30d"}' \
    | json_assert "data['to'] == '$parent_id' and data['workshopId'] == '$child_id' and data['clankerId'] == 'clanker-qa-child' and data['payload']['recommendation'] == '30d'"
report --state working --no-parent | json_assert 'data["to"] is None'

report --state blocked --to clanker-qa-other | json_assert 'data["to"] == "clanker-qa-other"'
printf '%s' '{"from":"stdin"}' | report --state done | json_assert 'data["payload"] == {"from": "stdin"}'
for bad in '[]' '"text"' '{broken' "$(python3 -c 'import json; print(json.dumps({"x": "y" * 70000}))')"; do
    set +e; error=$(report --state done --payload "$bad" 2>&1 >/dev/null); code=$?; set -e
    [[ $code -eq 2 ]] || fail "invalid payload exited $code, expected 2"
    printf '%s' "$error" | json_assert 'data["error"]["code"] == "INVALID_REQUEST"'
done
set +e; error=$( (cd "$root/child" && api report --state done) 2>&1 >/dev/null); code=$?; set -e
[[ $code -eq 2 ]] && printf '%s' "$error" | grep -q "Cannot identify the reporting clanker" || fail "report outside a clanker was accepted"
watch_once --timeout 5 >"$root/batch1"
json_assert "len(data) == 4 and all(event['type'] == 'reported' for event in data) and data[0]['message'] == 'Which retention?' and data[0]['payload']['options'] == ['7d', '30d'] and [event['seq'] for event in data] == sorted(event['seq'] for event in data)" lines <"$root/batch1"
expect_timeout 1
echo "PASS: A1 reports reach the parent's watch with validated payloads"

# A2: Reports are durable (each CLI call is its own process), and status shows the newest.
api status clanker-qa-child | json_assert 'data["lastReport"]["state"] == "done" and data["lastReport"]["payload"] == {"from": "stdin"} and data["state"] == "idle"'
echo "PASS: A2 status shows the durable lastReport without changing lifecycle state"

# A3 settled: one turn of the child settles; the event is emitted once.
hook "$child_pane" clanker-qa-child working '{"hook_event_name":"UserPromptSubmit","prompt":"go"}'
hook "$child_pane" clanker-qa-child done '{"hook_event_name":"Stop","background_tasks":[]}'
watch_once --timeout 5 | json_assert "len(data) == 1 and data[0]['type'] == 'settled' and data[0]['clankerId'] == 'clanker-qa-child' and data[0]['generation'] == 1 and data[0]['state'] == 'done'" lines
expect_timeout 1

# A3 resume: a long-running watch killed after emitting resumes without duplicates.
hook "$child_pane" clanker-qa-child working '{"hook_event_name":"UserPromptSubmit","prompt":"again"}'
hook "$child_pane" clanker-qa-child done '{"hook_event_name":"Stop","background_tasks":[]}'
# exec keeps the watch itself at $watch_pid, so the kill below reaches it.
(cd "$parent" && exec "${qa_env[@]}" "$repo/bin/clankers" watch --children-of "$parent_id" --descendants --cursor-file "$cursor" >"$root/stream" 2>"$root/stream.err") &
watch_pid=$!
for _ in {1..400}; do [[ -s "$root/stream" ]] && break; sleep 0.05; done
[[ -s "$root/stream" ]] || fail "long-running watch printed nothing: $(cat "$root/stream.err")"
sleep 0.3
kill -KILL "$watch_pid"; wait "$watch_pid" 2>/dev/null || true; watch_pid=""
json_assert "len(data) == 1 and data[0]['type'] == 'settled' and data[0]['generation'] == 2" lines <"$root/stream"
expect_timeout 1
echo "PASS: A3 settled once; a killed watch resumes exactly once from its cursor"

# A3 stale: a working turn with no hook event for longer than --stale-after.
hook "$child_pane" clanker-qa-child working '{"hook_event_name":"UserPromptSubmit","prompt":"slow"}'
sleep 1.2
watch_once --timeout 5 --stale-after 1 | json_assert "len(data) == 1 and data[0]['type'] == 'stale' and data[0]['generation'] == 3" lines
set +e; output=$(watch_once --timeout 1 --stale-after 1 2>/dev/null); code=$?; set -e
[[ $code -eq 124 && -z "$output" ]] || fail "stale was emitted twice for one silent stretch: $output"
echo "PASS: A3 stale emitted once per silent stretch"

# A3 spawned: a clanker in a new grandchild Workshop appears under --descendants.
shallow() { (cd "$parent" && api watch --children-of "$parent_id" --cursor-file "$root/shallow.cursor" --once --timeout 1 2>/dev/null); }
[[ -z "$(shallow || true)" ]] || fail "baseline children-only watch printed events"
read -r _ grandchild_pane <<<"$(claude_pane qa-grandchild "$root/grandchild" clanker-qa-grandchild)"
watch_once --timeout 5 | json_assert "len(data) == 1 and data[0] == {**data[0], 'type': 'spawned', 'clankerId': 'clanker-qa-grandchild', 'workshopId': '$grandchild_id', 'parentWorkshopId': '$child_id'}" lines
set +e; output=$(shallow); code=$?; set -e
[[ $code -eq 124 && -z "$output" ]] || fail "a watch without --descendants followed a grandchild: $output"
echo "PASS: A3 spawned for a new descendant Workshop's clanker"

# A3 exited: the child pane goes away.
[[ "$(mux read-claim --pane "$child_pane" clankerId)" == clanker-qa-child ]] || fail "refusing to kill an unexpected pane"
mux kill --session "$child_session" --pane "$child_pane"
watch_once --timeout 5 | json_assert "len(data) == 1 and data[0]['type'] == 'exited' and data[0]['clankerId'] == 'clanker-qa-child' and data[0]['workshopId'] == '$child_id'" lines
expect_timeout 1
echo "PASS: A3 exited once"

# --clanker watches follow named clankers only.
hook "$grandchild_pane" clanker-qa-grandchild working '{"hook_event_name":"UserPromptSubmit","prompt":"x"}'
hook "$grandchild_pane" clanker-qa-grandchild done '{"hook_event_name":"Stop","background_tasks":[]}'
(cd "$parent" && api watch --clanker clanker-qa-grandchild --cursor-file "$root/named.cursor" --once --timeout 1 >/dev/null 2>&1) || true
(cd "$root/grandchild" && "${qa_env[@]}" env CLANKER_ID=clanker-qa-grandchild "$repo/bin/clankers" report --state failed --message "tests red") >/dev/null
(cd "$parent" && api watch --clanker clanker-qa-grandchild --cursor-file "$root/named.cursor" --once --timeout 5) \
    | json_assert "len(data) == 1 and data[0]['type'] == 'reported' and data[0]['state'] == 'failed' and data[0]['to'] == '$child_id'" lines
echo "PASS: --clanker watch"

# R1: a clanker registers its own routine; it survives a runner restart and wakes the clanker
# through the ordinary send path when due.
routine() { (cd "$root/grandchild" && "${qa_env[@]}" env CLANKER_ID=clanker-qa-grandchild "$repo/bin/clankers" routine "$@"); }
start_runner
routine add --cron "0 9 * * 1-5" --tz Europe/Amsterdam --name standup --message "routine wake: check the board" >"$root/routine.json"
json_assert "data['clankerId'] == 'clanker-qa-grandchild' and data['timeZone'] == 'Europe/Amsterdam' and data['state'] == 'active' and '09:00 Europe/Amsterdam' in data['nextFire']" <"$root/routine.json"
routine_id=$(json_field routineId <"$root/routine.json")
set +e; error=$( (cd "$parent" && api routine add --cron "0 9 * * *" --message x) 2>&1 >/dev/null); code=$?; set -e
[[ $code -eq 2 ]] && printf '%s' "$error" | grep -q -- "--clanker ID" || fail "a routine without an owner was accepted"
set +e; (routine add --cron "61 * * * *" --message x) >/dev/null 2>&1; code=$?; set -e
[[ $code -eq 2 ]] || fail "an invalid cron was accepted"
set +e; (cd "$root/child" && "${qa_env[@]}" env CLANKER_ID=clanker-qa-other "$repo/bin/clankers" routine cancel "$routine_id") >/dev/null 2>&1; code=$?; set -e
[[ $code -eq 2 ]] || fail "another clanker cancelled a routine it did not name"
# The grandchild gets a stand-in for Claude's messaging socket that records what it receives.
inbox_sock="$root/grandchild-inbox.sock"
bun --eval '
  const [path, out] = process.argv.slice(1)
  const { appendFileSync } = await import("node:fs")
  Bun.listen({ unix: path, socket: { open(s) { s.data = "" }, data(s, d) { s.data += d.toString() }, close(s) { appendFileSync(out, s.data) } } })
' "$inbox_sock" "$root/grandchild-inbox.jsonl" &
inbox_pid=$!
for _ in {1..100}; do [[ -S "$inbox_sock" ]] && break; sleep 0.05; done
printf '%s' '{"hook_event_name":"SessionStart"}' | "${qa_env[@]}" env REX_BLOCK="$grandchild_pane" CLANKER_ID=clanker-qa-grandchild CLAUDE_CODE_MESSAGING_SOCKET="$inbox_sock" \
    "$repo/bin/clankerhouse-clanker-state-report" claude idle
stop_runner
routine list | json_assert "[r['routineId'] for r in data['routines']] == ['$routine_id']"
# Bring the next occurrence forward to now, as if 09:00 had come while the runner was down.
"${qa_env[@]}" bun --eval '
  const [modulePath, id] = process.argv.slice(1)
  const { RoutineStore } = await import(modulePath)
  const store = RoutineStore.open()
  store.db.query("UPDATE routines SET next_fire_at = ?2 WHERE routine_id = ?1").run(id, Date.now() - 1000)
  store.close()
' "$repo/src/routines.ts" "$routine_id"
start_runner
for _ in {1..200}; do
    routine show "$routine_id" | json_assert 'data["lastMessageId"] is not None' 2>/dev/null && break
    sleep 0.05
done
routine show "$routine_id" | json_assert 'data["lastOutcome"].startswith("fired") and data["lastError"] is None and data["nextFireAt"] > data["lastFiredAt"]' || fail "the due routine did not fire: $(cat "$runtime/runner.log")"
wake_id=$(routine show "$routine_id" | json_field lastMessageId)
"${qa_env[@]}" "$repo/bin/clankers" inbox list --all --clanker clanker-qa-grandchild \
    | json_assert "[m for m in data['messages'] if m['messageId'] == '$wake_id' and m['sender'] == 'routine:$routine_id' and m['source'] == 'routine' and m['text'] == 'routine wake: check the board']"
python3 -c 'import json,sys; lines=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]; assert len(lines) == 1 and lines[0]["message"]["content"].endswith("routine wake: check the board") and "from routine:" in lines[0]["message"]["content"], lines' "$root/grandchild-inbox.jsonl" \
    || fail "the wake did not reach the clanker's messaging socket"
grep -q "Routine $routine_id woke clanker-qa-grandchild" "$runtime/runner.log" || fail "the runner did not log the wake"
routine cancel "$routine_id" | json_assert 'data["cancelled"] is True'
routine list | json_assert 'data["routines"] == []'
echo "PASS: R1 a clanker's own routine survives a runner restart and wakes it through the send path"

api --help | grep -q "clankers watch" || fail "help omits watch"
api --help | grep -q "clankers routine add" || fail "help omits routine"
echo "Clankerhouse orchestration QA passed: report addressing and validation, durable lastReport, watch reported/settled/stale/spawned/exited exactly once, cursor resume after kill, and a clanker's own routine firing after a runner restart."
