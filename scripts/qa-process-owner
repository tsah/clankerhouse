#!/bin/bash
set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# shellcheck source=lib/qa-herdr-server
. "$repo/scripts/lib/qa-herdr-server"
root=$(mktemp -d /tmp/clankerhouse-process-owner-XXXXXX)
unit="clankerhouse-qa-${UID}-$$.scope"
cleanup() {
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
    qa_herdr_stop
    rm -rf "$root"
}
trap cleanup EXIT INT TERM
status=0
qa_herdr_start "$root/herdr" || status=$?
[[ "$status" != 77 ]] || exit 0
[[ "$status" == 0 ]] || exit "$status"

cat > "$root/tree" <<'SH'
#!/bin/bash
set -euo pipefail
echo $$ > "$QA_ROOT/wrapper.pid"
setsid bash -c 'echo $$ > "$QA_ROOT/setsid.pid"; sleep 60' &
(
    bash -c 'sleep 60' &
    echo $! > "$QA_ROOT/grandchild.pid"
    wait
) &
wait
SH
chmod 755 "$root/tree"

pane=$(qa_herdr workspace create --cwd "$root" --label qa --no-focus | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')
qa_herdr pane run "$pane" "env QA_ROOT='$root' systemd-run --user --scope --quiet --unit='$unit' --property=KillMode=control-group --property=SendSIGKILL=yes --property=CollectMode=inactive-or-failed -- '$root/tree'" >/dev/null
for _ in {1..100}; do [[ -s "$root/setsid.pid" && -s "$root/grandchild.pid" ]] && break; sleep 0.05; done
[[ -s "$root/setsid.pid" && -s "$root/grandchild.pid" ]] || { echo "Owned descendants did not start" >&2; exit 1; }
setsid_pid=$(<"$root/setsid.pid")
grandchild_pid=$(<"$root/grandchild.pid")

qa_herdr pane close "$pane" >/dev/null
kill -0 "$setsid_pid" 2>/dev/null || { echo "Fixture did not preserve the setsid child after pane loss" >&2; exit 1; }
systemctl --user stop "$unit"
for _ in {1..100}; do
    ! kill -0 "$setsid_pid" 2>/dev/null && ! kill -0 "$grandchild_pid" 2>/dev/null && break
    sleep 0.05
done
! kill -0 "$setsid_pid" 2>/dev/null || { echo "setsid descendant survived scope stop" >&2; exit 1; }
! kill -0 "$grandchild_pid" 2>/dev/null || { echo "grandchild survived scope stop" >&2; exit 1; }
printf 'Clankerhouse process-owner QA passed: pane loss cannot escape authoritative cgroup cleanup.\n'
