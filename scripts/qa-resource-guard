#!/bin/bash
set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
root=$(mktemp -d "/tmp/qa-clankerhouse-resource-guard-$(id -u)-XXXXXX")
harness_pid=""
workload_pid=""
cleanup() {
    for pid in "$workload_pid" "$harness_pid"; do
        [[ "$pid" =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
    rm -rf "$root"
}
trap cleanup EXIT INT TERM

mkdir -p "$root/home" "$root/state" "$root/run" "$root/proc/pressure" "$root/proc/sys/kernel/random" "$root/sys/class/dmi/id" "$root/bin"
pane_pid=$$
sleep 300 & harness_pid=$!
sleep 300 & workload_pid=$!

PANE_PID="$pane_pid" HARNESS_PID="$harness_pid" WORKLOAD_PID="$workload_pid" PROC_ROOT="$root/proc" python3 - <<'PY'
import os
from pathlib import Path
proc = Path(os.environ["PROC_ROOT"])
uid = os.getuid()
pane = int(os.environ["PANE_PID"])
harness = int(os.environ["HARNESS_PID"])
workload = int(os.environ["WORKLOAD_PID"])

def process(pid: int, parent: int, start: int, command: str, rss_kib: int):
    root = proc / str(pid)
    root.mkdir()
    fields = ["S", str(parent), *(["0"] * 17), str(start), "0"]
    (root / "stat").write_text(f"{pid} ({command}) " + " ".join(fields) + "\n")
    (root / "status").write_text(f"Name:\t{command}\nUid:\t{uid}\t{uid}\t{uid}\t{uid}\nVmRSS:\t{rss_kib} kB\n")
    (root / "cmdline").write_bytes(f"/usr/bin/{command}\0".encode())
    (root / "comm").write_text(command + "\n")
    (root / "io").write_text("read_bytes: 0\nwrite_bytes: 0\n")

process(pane, 1, 50, "bash", 4 * 1024)
process(harness, pane, 100, "pi", 32 * 1024)
process(workload, harness, 200, "cargo", 512 * 1024)
PY

cat >"$root/proc/meminfo" <<'EOF'
MemTotal:       8388608 kB
MemAvailable:    100000 kB
SwapTotal:            0 kB
EOF
cat >"$root/proc/pressure/memory" <<'EOF'
some avg10=20.00 avg60=20.00 avg300=20.00 total=1
full avg10=3.00 avg60=3.00 avg300=3.00 total=1
EOF
for resource in io cpu; do
    cat >"$root/proc/pressure/$resource" <<'EOF'
some avg10=0.00 avg60=0.00 avg300=0.00 total=0
full avg10=0.00 avg60=0.00 avg300=0.00 total=0
EOF
done
printf 'qa-boot\n' >"$root/proc/sys/kernel/random/boot_id"
printf 'QA\n' >"$root/sys/class/dmi/id/sys_vendor"
printf 'fixture\n' >"$root/sys/class/dmi/id/product_name"

# Multiplexer discovery goes through `clankers mux observe`; every other call is a steering send.
cat >"$root/observe.json" <<EOF
{"kind":"herdr","instanceId":"herdr:qa","sessions":[{"id":"w1","nativeName":"qa-session","path":"$root/worktree","recency":0,"attached":true,"worktreePath":"$root/worktree","directoryPath":"","windows":[{"id":"w1:t1","index":"0","nativeName":"pi","active":true,"panes":[{"id":"w1:p1","index":"0","pid":"$pane_pid","command":"pi","title":"","currentPath":"$root/worktree","activity":0,"active":false,"claims":{"harness":"pi","clankerId":"qa-clanker","clankerPid":"$harness_pid"}}]}]}]}
EOF
cat >"$root/bin/clankers" <<EOF
#!/bin/sh
if [ "\$1 \$2" = "mux observe" ]; then cat '$root/observe.json'; exit 0; fi
printf '%s\n' "\$*" >>'$root/steering.log'
EOF
chmod +x "$root/bin/clankers"

HOME="$root/home" XDG_STATE_HOME="$root/state" XDG_RUNTIME_DIR="$root/run" \
PATH="$root/bin:$PATH" CLANKERHOUSE_CLANKERS="$root/bin/clankers" CLANKERHOUSE_HOME="$repo" CLANKERHOUSE_PROC_ROOT="$root/proc" \
CLANKERHOUSE_SYSFS_ROOT="$root/sys" RESOURCE_GUARD_SAMPLES=1 RESOURCE_GUARD_TERM_GRACE=0 \
RESOURCE_GUARD_COOLDOWN=120 RESOURCE_GUARD_READ_LIMIT_MIB_PER_SEC=0 \
"$repo/bin/clankerhouse-resource-guard" --once >"$root/guard.log"

kill -0 "$harness_pid"
stopped=0
for _ in {1..50}; do
    if ! kill -0 "$workload_pid" 2>/dev/null || [[ "$(ps -o stat= -p "$workload_pid" 2>/dev/null)" == Z* ]]; then
        stopped=1
        break
    fi
    sleep 0.02
done
[[ "$stopped" == 1 ]] || { echo "Resource Guard did not stop the workload" >&2; cat "$root/guard.log" >&2; exit 1; }
grep -F 'send qa-clanker --delivery steer --text Resource Guard stopped child process cargo' "$root/steering.log" >/dev/null
incident=$(find "$root/state/clankerhouse-herdr/incidents" -type f -name '*resource_pressure_workload_stop*' -print -quit)
[[ -n "$incident" ]]
python3 - "$incident" "$workload_pid" <<'PY'
import json, sys
incident = json.load(open(sys.argv[1]))
assert incident["kind"] == "resource_pressure_workload_stop"
assert incident["clanker"]["clankerId"] == "qa-clanker"
assert incident["evidence"]["process"]["pid"] == int(sys.argv[2])
PY

echo "Clankerhouse Resource Guard QA passed: an isolated heavy child workload stopped, its Clanker survived, and steering received incident context."
