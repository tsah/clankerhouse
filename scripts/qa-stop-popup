#!/bin/bash

set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
root=$(realpath -m -- "${CLANKERHOUSE_STOP_POPUP_QA_ROOT:-/tmp/qa-clankerhouse-stop-popup-$(id -u)-$$}")
[[ "$root" =~ ^/tmp/qa-clankerhouse-stop-popup-[A-Za-z0-9._-]+$ ]] || { echo "Refusing unsafe stop-popup QA root: $root" >&2; exit 2; }
marker="$root.clankerhouse-qa-owned"
socket="$root/tmux.sock"
runtime="$root/runtime"
state_home="$root/state"
qa_home="$root/home"
native_tui_pid=""
[[ ! -e "$root" || -f "$marker" ]] || { echo "Refusing unowned stop-popup QA root: $root" >&2; exit 2; }
rm -rf -- "$root"
mkdir -p "$root" "$runtime" "$state_home" "$qa_home"
chmod 700 "$runtime" "$state_home" "$qa_home"
touch "$marker"
export XDG_RUNTIME_DIR="$runtime"
export XDG_STATE_HOME="$state_home"
export HOME="$qa_home"
export CLANKERHOUSE_MULTIPLEXER=tmux
export HERDR_ENV=
export HERDR_PANE_ID=

cleanup() {
    if [[ "$native_tui_pid" =~ ^[0-9]+$ ]]; then kill "$native_tui_pid" 2>/dev/null || true; fi
    tmux -S "$socket" kill-server 2>/dev/null || true
    [[ -f "$marker" ]] && rm -rf -- "$root" "$marker"
}
trap cleanup EXIT INT TERM

cat > "$root/clankers" <<'SH'
#!/bin/bash
sleep 1
exit 0
SH
chmod +x "$root/clankers"

tmux -S "$socket" new-session -d -s delete-me 'sleep 60'
pane=$(tmux -S "$socket" list-panes -t delete-me -F '#{pane_id}')
tmux -S "$socket" set-option -p -t "$pane" @clankerhouse_clanker_id clanker-popup-qa
tmux -S "$socket" new-session -d -s survivor 'sleep 60'
session_id=$(tmux -S "$socket" display-message -p -t delete-me:0 '#{session_id}')
server_pid=$(tmux -S "$socket" display-message -p '#{pid}')
tmux -S "$socket" set-option -g @clankerhouse-home "$repo"
TMUX="$socket,$server_pid,0" "$repo/clankerhouse.tmux"

# The worktree popup presents the daemon's durable stages in effect order,
# including the two destructive effects the operator needs to distinguish.
mkdir -p "$root/popup-bin" "$root/libexec"
cp "$repo/bin/clankerhouse-stop-popup" "$root/popup-bin/clankerhouse-stop-popup"
cp "$repo/libexec/clankerhouse-env" "$root/libexec/clankerhouse-env"
cat > "$root/popup-bin/clankers" <<'SH'
#!/bin/bash
[[ "$*" == *"delete worktree"* ]] || exit 2
printf 'CLANKERHOUSE_PROGRESS\tValidating worktree identity\n' >&2
printf 'CLANKERHOUSE_PROGRESS\tStopping tracked Clankers\n' >&2
printf 'CLANKERHOUSE_PROGRESS\tDeleting worktree\n' >&2
printf 'CLANKERHOUSE_PROGRESS\tDeleting tmux session\n' >&2
printf 'CLANKERHOUSE_PROGRESS\tRefreshing Clankerhouse\n' >&2
if [[ "${QA_DELETE_FAIL:-0}" == 1 ]]; then
    printf '%s\n' '{"apiVersion":1,"error":{"code":"INVALID_REQUEST","message":"Cannot remove the default branch master\nKeep the branch and remove only its worktree"}}' >&2
    exit 2
fi
SH
chmod +x "$root/popup-bin/clankers"
printf y | env \
    LC_ALL=C LANG=C TERM=tmux-256color \
    TMUX="$socket,$server_pid,0" \
    CLANKERHOUSE_DELETE_KIND=worktree \
    CLANKERHOUSE_DELETE_PATH="$root/example-worktree" \
    "$root/popup-bin/clankerhouse-stop-popup" "$session_id" delete-me \
    >"$root/worktree-progress-output" 2>&1
python3 - "$root/worktree-progress-output" <<'PY'
import pathlib
import sys

output = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8", errors="strict")
steps = ["Deleting worktree", "Deleting tmux session", "Refreshing Clankerhouse"]
positions = [output.rfind(step) for step in steps]
if any(position < 0 for position in positions) or positions != sorted(positions):
    raise SystemExit(f"Worktree deletion progress missing or out of order: {positions}")
if "Destroyed session and worktree." not in output:
    raise SystemExit("Worktree deletion popup did not show its successful outcome")
if "·" not in output or "█" not in output or "�" in output:
    raise SystemExit("Worktree deletion progress is not valid UTF-8 under the POSIX locale")
PY

set +e
printf yx | env \
    LC_ALL=C LANG=C TERM=tmux-256color \
    TMUX="$socket,$server_pid,0" \
    QA_DELETE_FAIL=1 \
    CLANKERHOUSE_DELETE_KIND=worktree \
    CLANKERHOUSE_DELETE_PATH="$root/example-worktree" \
    "$root/popup-bin/clankerhouse-stop-popup" "$session_id" delete-me \
    >"$root/worktree-error-output" 2>&1
failure_status=$?
set -e
[[ "$failure_status" -eq 2 ]] || { printf 'Expected mocked deletion failure, got exit %s\n' "$failure_status" >&2; exit 1; }
python3 - "$root/worktree-error-output" <<'PY'
import pathlib
import sys

output = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8", errors="strict")
final_frame = output.rsplit("\x1b[2J\x1b[H", 1)[-1]
for detail in ["Cannot remove the default branch master", "Keep the branch and remove only its worktree"]:
    if detail not in final_frame:
        raise SystemExit(f"Final deletion failure omitted actionable detail: {detail}")
PY

# Worktrunk 0.67 refuses its own --no-delete-branch mode for the repository's
# default branch. The helper must move that worktree to a disposable branch,
# remove it through Worktrunk, preserve the default branch, and leave no
# disposable branch behind.
default_source="$root/default-source"
default_repository="$root/default-repository"
default_worktree="$root/default-worktree"
default_bin="$root/default-bin"
default_wt_log="$root/default-wt.log"
real_wt=$(command -v wt)
git -C "$root" init -q -b main "$default_source"
git -C "$default_source" config user.name QA
git -C "$default_source" config user.email qa@example.invalid
printf fixture >"$default_source/fixture"
git -C "$default_source" add fixture
git -C "$default_source" commit -qm fixture
mkdir -p "$default_repository" "$default_bin"
git clone -q --bare "$default_source" "$default_repository/.git"
git --git-dir="$default_repository/.git" worktree add -q "$default_worktree" main
cat >"$default_bin/wt" <<'SH'
#!/bin/bash
printf '%s\n' "$*" >>"$DEFAULT_WT_LOG"
[[ "${FAIL_WT:-0}" != 1 ]] || exit 17
exec "$REAL_WT" "$@"
SH
chmod +x "$default_bin/wt"
env \
    PATH="$default_bin:$PATH" \
    REAL_WT="$real_wt" \
    DEFAULT_WT_LOG="$default_wt_log" \
    TMUX="$socket,$server_pid,0" \
    "$repo/libexec/worktree-delete" --yes "$default_worktree"
[[ ! -d "$default_worktree" ]] || { printf 'Default-branch worktree survived deletion\n' >&2; exit 1; }
[[ -s "$default_wt_log" ]] || { printf 'Default-branch worktree bypassed Worktrunk\n' >&2; exit 1; }
grep -F 'remove --foreground --force' "$default_wt_log" >/dev/null || {
    printf 'Default-branch worktree used the wrong Worktrunk command\n' >&2
    exit 1
}
if grep -F -- '--no-delete-branch' "$default_wt_log" >/dev/null; then
    printf 'Default-branch disposable branch was incorrectly preserved\n' >&2
    exit 1
fi
git --git-dir="$default_repository/.git" show-ref --verify --quiet refs/heads/main || {
    printf 'Default branch was deleted with its worktree\n' >&2
    exit 1
}
if git --git-dir="$default_repository/.git" for-each-ref --format='%(refname)' refs/heads/clankerhouse-delete/ | grep -q .; then
    printf 'Disposable deletion branch survived worktree removal\n' >&2
    exit 1
fi

# A Worktrunk failure after the temporary switch must restore the default
# branch and leave the worktree untouched.
git --git-dir="$default_repository/.git" worktree add -q "$default_worktree" main
set +e
env \
    PATH="$default_bin:$PATH" \
    REAL_WT="$real_wt" \
    DEFAULT_WT_LOG="$default_wt_log" \
    FAIL_WT=1 \
    TMUX="$socket,$server_pid,0" \
    "$repo/libexec/worktree-delete" --yes "$default_worktree" \
    >"$root/default-rollback-output" 2>&1
rollback_status=$?
set -e
[[ "$rollback_status" -eq 17 ]] || { printf 'Expected Worktrunk rollback exit 17, got %s\n' "$rollback_status" >&2; exit 1; }
[[ -d "$default_worktree" ]] || { printf 'Failed Worktrunk removal deleted the default worktree\n' >&2; exit 1; }
[[ "$(git -C "$default_worktree" symbolic-ref --short HEAD)" == main ]] || {
    printf 'Failed Worktrunk removal did not restore the default branch\n' >&2
    exit 1
}
if git --git-dir="$default_repository/.git" for-each-ref --format='%(refname)' refs/heads/clankerhouse-delete/ | grep -q .; then
    printf 'Failed Worktrunk removal left a disposable branch\n' >&2
    exit 1
fi

# The root M-d binding must forward to either picker implementation rather
# than opening the standalone deletion popup over an active TUI.
cp /bin/sleep "$root/clankerhouse-native"
env TMUX_PANE=%99 "$root/clankerhouse-native" 30 &
native_tui_pid=$!
for _ in {1..50}; do
    "$repo/bin/clankerhouse-tui-active" %99 && break
    sleep 0.02
done
if ! "$repo/bin/clankerhouse-tui-active" %99; then
    printf 'Native Clankerhouse TUI was not detected\n' >&2
    exit 1
fi
if "$repo/bin/clankerhouse-tui-active" %98; then
    printf 'Native Clankerhouse TUI matched the wrong pane\n' >&2
    exit 1
fi
kill "$native_tui_pid"
wait "$native_tui_pid" 2>/dev/null || true
native_tui_pid=""

# A popup is client-scoped and may not inherit the underlying TMUX_PANE. The
# detector must still recognize its explicit requesting client without matching
# another client.
env -u TMUX_PANE CLANKERHOUSE_TMUX_CLIENT=qa-popup-client "$root/clankerhouse-native" 30 &
native_tui_pid=$!
for _ in {1..50}; do
    "$repo/bin/clankerhouse-tui-active" %98 qa-popup-client && break
    sleep 0.02
done
if ! "$repo/bin/clankerhouse-tui-active" %98 qa-popup-client; then
    printf 'Client-scoped native popup was not detected\n' >&2
    exit 1
fi
if "$repo/bin/clankerhouse-tui-active" %98 other-client; then
    printf 'Native popup matched the wrong tmux client\n' >&2
    exit 1
fi
kill "$native_tui_pid"
wait "$native_tui_pid" 2>/dev/null || true
native_tui_pid=""

# A popup must receive Alt-D itself. tmux closes a popup before executing a
# global M-d binding, so the popup launcher temporarily removes that binding
# and restores it when the popup exits.
cat > "$root/fake-jump" <<EOF
#!/bin/bash
stty raw -echo
exec dd bs=1 count=2 of='$root/popup-input' status=none
EOF
chmod +x "$root/fake-jump"
tmux -S "$socket" bind-key -n M-k run-shell \
    "'$repo/bin/clankerhouse-popup' '#{client_name}' '#{session_name}' '$root/fake-jump'"
SOCKET="$socket" python3 - <<'PY'
import os
import pty
import subprocess
import time

master, slave = pty.openpty()
client = subprocess.Popen(
    ["tmux", "-S", os.environ["SOCKET"], "attach-session", "-t", "survivor"],
    stdin=slave,
    stdout=slave,
    stderr=slave,
    close_fds=True,
)
os.close(slave)
time.sleep(0.3)
os.write(master, b"\x1bk")
time.sleep(0.3)
keys = subprocess.check_output(["tmux", "-S", os.environ["SOCKET"], "list-keys", "-T", "root"], text=True)
if "M-d" in keys:
    raise SystemExit("Popup launcher restored M-d before the popup exited")
os.write(master, b"\x1bd")
time.sleep(0.5)
client.terminate()
client.wait(timeout=2)
os.close(master)
PY
[[ -f "$root/popup-input" ]] || { printf 'Popup did not receive forwarded Alt-D\n' >&2; exit 1; }
popup_input=$(od -An -tx1 "$root/popup-input" | tr -d ' \n')
[[ "$popup_input" == 1b64 ]] || {
    printf 'Popup received the wrong Alt-D bytes: %s\n' "$popup_input" >&2
    exit 1
}
tmux -S "$socket" list-keys -T root | grep -F 'M-d' >/dev/null || {
    printf 'Popup launcher did not restore the root Alt-D binding\n' >&2
    exit 1
}
TMUX="$socket,$server_pid,0" "$repo/clankerhouse.tmux"

# Exercise the public key binding through a real attached tmux client. Writing
# Escape+d to its PTY reproduces the terminal path that a direct script call
# cannot: tmux consumes Alt-D, creates the popup, and supplies its target context.
SOCKET="$socket" OUTPUT="$root/output" python3 - <<'PY'
import fcntl
import os
import pty
import signal
import struct
import subprocess
import termios
import time

socket = os.environ["SOCKET"]
output_path = os.environ["OUTPUT"]
pid, fd = pty.fork()
if pid == 0:
    os.environ["TERM"] = "xterm-256color"
    os.execvp("tmux", ["tmux", "-S", socket, "attach-session", "-t", "delete-me"])
fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 30, 100, 0, 0))
fcntl.fcntl(fd, fcntl.F_SETFL, os.O_NONBLOCK)
output = bytearray()

def drain():
    while True:
        try:
            chunk = os.read(fd, 65536)
            if not chunk:
                return
            output.extend(chunk)
        except BlockingIOError:
            return
        except OSError:
            return

def session_exists(name):
    return subprocess.run(
        ["tmux", "-S", socket, "has-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0

try:
    time.sleep(0.3)
    drain()
    os.write(fd, b"\x1bd")
    popup_deadline = time.monotonic() + 5
    while b"Press " not in output and time.monotonic() < popup_deadline:
        time.sleep(0.05)
        drain()
    if b"Press " not in output:
        raise SystemExit("Alt-D confirmation popup did not open")
    os.write(fd, b"y")
    deadline = time.monotonic() + 5
    while session_exists("delete-me") and time.monotonic() < deadline:
        time.sleep(0.05)
        drain()
    drain()
finally:
    with open(output_path, "wb") as stream:
        stream.write(output)
    try:
        os.write(fd, b"\x02d")
    except OSError:
        pass
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass

if session_exists("delete-me"):
    print(output.decode("utf-8", errors="replace")[-2000:])
    raise SystemExit("Alt-D popup did not remain open and confirm deletion")
PY

tmux -S "$socket" has-session -t '=survivor'
grep -q 'Destroying tmux session' "$root/output"
grep -q 'Finding tracked clankers' "$root/output"
grep -q 'Persisting stop intent' "$root/output"
grep -q 'Stop intents persisted' "$root/output"
grep -F "\$command_dir/clankerhouse-delete" "$repo/clankerhouse.tmux" >/dev/null
grep -F 'clankerhouse-tui-active' "$repo/bin/clankerhouse-delete" >/dev/null
grep -F 'CLANKERHOUSE_DELETE_KIND' "$repo/bin/clankerhouse-delete" >/dev/null
grep -F 'clankers" delete worktree' "$repo/bin/clankerhouse-stop-popup" >/dev/null
grep -F 'clankerhouse-stop-popup' "$repo/bin/clankerhouse-delete" >/dev/null

printf 'Clankerhouse standalone stop popup QA passed: confirmation, animated detailed progress, durable stop intent, target deletion, and surviving-session preservation behave correctly.\n'
