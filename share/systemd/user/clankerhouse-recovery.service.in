[Unit]
Description=Clankerhouse durable workshop and clanker boot recovery
Documentation=file:@CLANKERHOUSE_HOME@/README.md
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="@CLANKERHOUSE_BIN@/clankerhouse-recovery"
Restart=on-failure
RestartSec=15s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
