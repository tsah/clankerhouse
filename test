#!/bin/bash

# Authoritative top-level Clankerhouse test entrypoint.
# Default: static checks, every unit/component test, and every isolated standalone scenario.
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
cd "$root"

mode=all
case "${1:-}" in
    ""|--all) mode=all ;;
    --unit) mode=unit ;;
    --standalone) mode=standalone ;;
    --list)
        cat <<'EOF'
unit/static:
  feature-catalogue, TypeScript, Rust
standalone/end-to-end:
  native-hot, Neovim, Clanker API, orchestration, spawn model, runner, process owner,
  lineage actions, status hooks, Claude accounts, workshop labels, Rex lane, installer, full TUI
EOF
        exit 0
        ;;
    *) printf 'Usage: ./test [--all|--unit|--standalone|--list]\n' >&2; exit 2 ;;
esac

started=$SECONDS
passed=0
pending=()
# Scenarios ported to the Rex fixture that still fail on a product bug named beside each.
pending() {
    printf '\n\033[1;33m==> %s: PENDING product fix (%s)\033[0m\n' "$1" "$2"
    pending+=("$1")
}
run() {
    local name=$1
    shift
    printf '\n\033[1;36m==> %s\033[0m\n' "$name"
    "$@"
    passed=$((passed + 1))
}

if [[ "$mode" == all || "$mode" == unit ]]; then
    run "feature coverage" scripts/check-feature-coverage
    run "TypeScript static check" bun run check
    # Lifecycle tests execute the native hook, so build it first.
    run "native hook build" cargo build --manifest-path native-client/Cargo.toml --release --locked --bin clankerhouse-hook
    run "TypeScript unit and component tests" bun test
    run "Rust native-client unit tests" cargo test --manifest-path native-client/Cargo.toml
fi

if [[ "$mode" == all || "$mode" == standalone ]]; then
    run "native hot-start scenario" scripts/qa-native-hot
    run "Neovim integration scenario" scripts/qa-nvim
    run "Clanker API scenario" scripts/qa-clanker-api
    run "orchestration reports and watch scenario" scripts/qa-orchestration
    run "spawn model override scenario" scripts/qa-spawn-model
    run "runner scenario" scripts/qa-runner
    run "process ownership scenario" scripts/qa-process-owner
    run "attach and delete-lineage scenario" scripts/qa-lineage-actions
    run "status hooks scenario" scripts/qa-status-hooks
    # The Rex part skips without rex unless REX_REQUIRED is set.
    run "Claude account switching scenario" scripts/qa-claude-accounts
    run "workshop labels and repository hooks scenario" scripts/qa-workshop-labels
    # Skips without rex unless REX_REQUIRED is set.
    run "Rex lane scenario" scripts/qa-rex
    run "atomic installer and rollback scenario" scripts/qa-install
    run "complete native TUI interaction scenario" scripts/qa
fi

((${#pending[@]})) && printf '\n\033[1;33m%d scenario(s) pending a product fix after their Rex port: %s\033[0m\n' "${#pending[@]}" "${pending[*]}"
printf '\n\033[1;32mAll %d Clankerhouse test groups passed in %ds (%s mode).\033[0m\n' "$passed" "$((SECONDS - started))" "$mode"
